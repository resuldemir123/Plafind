@model IEnumerable<Plafind.Models.Business>
@Html.AntiForgeryToken()
@{
    var businesses = Model?.ToList() ?? new List<Plafind.Models.Business>();
    var featuredBusinesses = businesses
        .Where(b => b.IsFeatured)
        .OrderByDescending(b => b.AverageRating)
        .Take(6)
        .ToList();

    var trendingBusinesses = businesses
        .OrderByDescending(b => b.TotalReviews)
        .ThenByDescending(b => b.AverageRating)
        .Take(6)
        .ToList();

    var allBusinessIds = new HashSet<int>(featuredBusinesses.Select(b => b.Id));
    foreach (var biz in trendingBusinesses)
    {
        allBusinessIds.Add(biz.Id);
    }

    var remainingBusinesses = businesses
        .Where(b => !allBusinessIds.Contains(b.Id))
        .OrderByDescending(b => b.AverageRating)
        .ToList();

    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var query = ViewBag.Query as string ?? string.Empty;
    var selectedCategory = ViewBag.Category as string ?? string.Empty;
    var minRating = ViewBag.MinRating as string ?? string.Empty;
    var priceRange = ViewBag.PriceRange as string ?? string.Empty;
    var sortBy = (ViewBag.SortBy as string ?? "featured").ToLower();
}

<section class="search-hero">
    <div class="hero-overlay">
        <div class="container-fluid px-3 px-md-4">
            <p class="eyebrow">Alanya İşletmeleri</p>
            <h1>Aradığın deneyimi saniyeler içinde bul</h1>
            <p class="lead">Restoranlardan aktivitelere kadar yüzlerce işletme arasından filtrele, karşılaştır, hemen keşfet.</p>

            <form asp-action="Search" asp-controller="Home" method="get" class="search-bar row gx-2 gy-2">
                <div class="col-lg-4">
                    <div class="input-pill">
                        <i class="fas fa-search"></i>
                        <input type="text" name="query" value="@query" placeholder="İşletme adı, mutfak türü veya mahalle" />
                    </div>
                </div>
                <div class="col-lg-3">
                    <select name="category" class="input-pill">
                        <option value="" selected="@(string.IsNullOrEmpty(selectedCategory) ? "selected" : null)">Tüm kategoriler</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat" selected="@(cat == selectedCategory ? "selected" : null)">@cat</option>
                        }
                    </select>
                </div>
                <div class="col-lg-2">
                    <select name="minRating" class="input-pill">
                        <option value="" selected="@(string.IsNullOrEmpty(minRating) ? "selected" : null)">Puan</option>
                        <option value="4.5" selected="@(minRating == "4.5" ? "selected" : null)">4.5+</option>
                        <option value="4" selected="@(minRating == "4" ? "selected" : null)">4.0+</option>
                        <option value="3.5" selected="@(minRating == "3.5" ? "selected" : null)">3.5+</option>
                    </select>
                </div>
                <div class="col-lg-2">
                    <select name="priceRange" class="input-pill">
                        <option value="" selected="@(string.IsNullOrEmpty(priceRange) ? "selected" : null)">Fiyat</option>
                        <option value="$" selected="@(priceRange == "$" ? "selected" : null)">$</option>
                        <option value="$$" selected="@(priceRange == "$$" ? "selected" : null)">$$</option>
                        <option value="$$$" selected="@(priceRange == "$$$" ? "selected" : null)">$$$</option>
                    </select>
                </div>
                <div class="col-lg-1 d-grid">
                    <button type="submit" class="btn btn-primary rounded-pill">Ara</button>
                </div>
            </form>

            <div class="filter-chips">
                <span class="chip @(string.IsNullOrEmpty(sortBy) || sortBy == "featured" ? "active" : string.Empty)" data-sort="featured">Öne çıkanlar</span>
                <span class="chip @(sortBy == "rating" ? "active" : string.Empty)" data-sort="rating">En yüksek puan</span>
                <span class="chip @(sortBy == "reviews" ? "active" : string.Empty)" data-sort="reviews">En çok yorum</span>
                <span class="chip @(sortBy == "distance" ? "active" : string.Empty)" data-sort="distance">Yakındakiler</span>
            </div>
        </div>
    </div>
</section>

<section class="search-sections py-5">
    <div class="container-fluid px-3 px-md-4">
        @if (featuredBusinesses.Any())
        {
            <div class="section-header">
                <div>
                    <p class="eyebrow">Öne Çıkan İşletmeler</p>
                    <h2>Seçtiğimiz favoriler</h2>
                </div>
                <span class="badge rounded-pill" style="background-color: #2563EB; color: #FFFFFF;">@featuredBusinesses.Count</span>
            </div>
            <div class="featured-carousel">
                @foreach (var business in featuredBusinesses)
                {
                    <article class="business-card highlight">
                        <div class="card-cover" style="background-image:url('@(string.IsNullOrWhiteSpace(business.ImageUrl) ? Url.Content("~/images/190_alanya.jpg") : business.ImageUrl)');"></div>
                        <div class="card-body">
                            <div class="card-badge">
                                <i class="fas fa-crown me-1"></i>Öne Çıkan
                            </div>
                            <h3>@business.Name</h3>
                            <p>@(business.Description?.Length > 80 ? business.Description[..80] + "..." : business.Description ?? "Açıklama eklenmemiş.")</p>
                            <div class="card-meta">
                                <span><i class="fas fa-star" style="color: #2563EB;"></i>@business.AverageRating.ToString("F1")</span>
                                <span><i class="fas fa-comment"></i>@business.TotalReviews yorum</span>
                                <span><i class="fas fa-tag"></i>@business.Category?.Name</span>
                            </div>
                            <a asp-controller="Businesses" asp-action="Details" asp-route-id="@business.Id" class="btn btn-primary btn-sm rounded-pill">İncele</a>
                        </div>
                    </article>
                }
            </div>
        }

        @if (trendingBusinesses.Any())
        {
            <div class="section-header mt-5">
                <div>
                    <p class="eyebrow">Popüler Seçimler</p>
                    <h2>Topluluğun favorileri</h2>
                </div>
                <span class="badge rounded-pill" style="background-color: #14B8A6; color: #FFFFFF;">@trendingBusinesses.Count</span>
            </div>
            <div class="trending-grid">
                @foreach (var business in trendingBusinesses)
                {
                    <article class="business-card compact">
                        <div>
                            <h3>@business.Name</h3>
                            <p>@business.Category?.Name</p>
                        </div>
                        <div class="rating">
                            <strong>@business.AverageRating.ToString("F1")</strong>
                            <span>@business.TotalReviews yorum</span>
                        </div>
                        <a asp-controller="Businesses" asp-action="Details" asp-route-id="@business.Id" class="btn btn-outline-primary btn-sm rounded-pill">Detay</a>
                    </article>
                }
            </div>
        }

        <div class="section-header mt-5">
            <div>
                <p class="eyebrow">Tüm Sonuçlar</p>
                <h2>Keşfedilecek diğer işletmeler</h2>
            </div>
            <span class="badge rounded-pill" style="background-color: #334155; color: #FFFFFF;">@businesses.Count</span>
        </div>

        @if (businesses.Any())
        {
            <div class="results-grid">
                @foreach (var business in businesses)
                {
                    <article class="business-card basic">
                        <div class="card-cover" style="background-image:url('@(string.IsNullOrWhiteSpace(business.ImageUrl) ? Url.Content("~/images/190_alanya.jpg") : business.ImageUrl)');"></div>
                        <div class="card-body">
                            <div class="card-top">
                                <div>
                                    <h3>@business.Name</h3>
                                    @if (business.Category != null)
                                    {
                                        <p class="muted">@business.Category.Name</p>
                                    }
                                </div>
                                <div class="rating">
                                    <strong>@business.AverageRating.ToString("F1")</strong>
                                    <span>@business.TotalReviews yorum</span>
                                </div>
                            </div>
                            <p class="address">
                                <i class="fas fa-map-marker-alt me-1"></i>
                                @(string.IsNullOrWhiteSpace(business.Address) ? "Adres bilgisi eklenmemiş" : business.Address)
                            </p>
                            <div class="card-actions">
                                @if (!string.IsNullOrEmpty(business.Phone))
                                {
                                    <a href="tel:@business.Phone" class="link">
                                        <i class="fas fa-phone"></i> Ara
                                    </a>
                                }
                                <a asp-controller="Businesses" asp-action="Details" asp-route-id="@business.Id" class="btn btn-primary btn-sm rounded-pill">Detay</a>
                                <button class="btn btn-sm btn-outline-primary rounded-pill compare-btn-search" 
                                        data-business-id="@business.Id" 
                                        title="Karşılaştırmaya ekle">
                                    <i class="fas fa-balance-scale"></i>
                                </button>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-search"></i>
                <h3>Sonuç bulunamadı</h3>
                <p>Filtreleri gevşetmeyi veya farklı bir anahtar kelime denemeyi düşünün.</p>
            </div>
        }
    </div>
</section>

<style>
    /* Dark Mode - İşletme Ara Sayfası */
    .search-hero {
        background: linear-gradient(135deg, #0B1220 0%, #1E293B 50%, #0B1220 100%);
        background-image: radial-gradient(circle at 20% 30%, rgba(37, 99, 235, 0.15) 0%, transparent 50%),
                          radial-gradient(circle at 80% 70%, rgba(20, 184, 166, 0.1) 0%, transparent 50%);
        color: #FFFFFF;
        padding: 4rem 0 2rem;
        position: relative;
    }

    .hero-overlay .eyebrow {
        text-transform: uppercase;
        letter-spacing: .25em;
        font-size: .85rem;
        color: #94A3B8 !important;
        font-weight: 600;
    }

    .hero-overlay h1 {
        font-weight: 800;
        margin-bottom: 1rem;
        color: #FFFFFF !important;
    }

    .hero-overlay .lead {
        color: #94A3B8 !important;
        margin-bottom: 2rem;
        max-width: 600px;
        font-weight: 500;
    }

    .search-bar .input-pill {
        display: flex;
        align-items: center;
        gap: .5rem;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 999px;
        padding: .75rem 1.2rem;
        border: 2px solid #334155;
        color: #FFFFFF;
        backdrop-filter: blur(10px);
        transition: all 0.3s ease;
    }

    .search-bar .input-pill:focus-within {
        border-color: #2563EB;
        background: rgba(255, 255, 255, 0.08);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    }

    .search-bar input,
    .search-bar select {
        background: transparent;
        border: none;
        color: #FFFFFF !important;
        width: 100%;
        outline: none;
        font-weight: 500;
    }
    
    .search-bar input::placeholder {
        color: #94A3B8 !important;
        opacity: 0.7;
    }

    .search-bar select option {
        color: #FFFFFF !important;
        background: #1E293B !important;
    }

    .filter-chips {
        display: flex;
        gap: .75rem;
        flex-wrap: wrap;
        margin-top: 1.5rem;
    }

    .filter-chips .chip {
        padding: .5rem 1rem;
        border-radius: 999px;
        border: 2px solid #334155;
        cursor: pointer;
        color: #94A3B8 !important;
        transition: all .2s ease;
        background: rgba(255, 255, 255, 0.05);
    }

    .filter-chips .chip.active,
    .filter-chips .chip:hover {
        background: #2563EB;
        color: #FFFFFF !important;
        border-color: #2563EB;
    }

    .search-sections {
        background: linear-gradient(180deg, #0B1220 0%, #1E293B 50%, #0B1220 100%);
        color: #FFFFFF;
        padding: 3rem 0;
    }

    .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .section-header h2 {
        margin: 0;
        font-weight: 800;
        color: #FFFFFF !important;
    }

    .section-header .eyebrow {
        color: #94A3B8 !important;
        margin-bottom: .35rem;
        font-weight: 600;
    }

    .featured-carousel {
        display: grid;
        gap: 1.2rem;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }

    .business-card {
        background: #1E293B;
        border-radius: 1.25rem;
        overflow: hidden;
        border: 1px solid #334155;
        display: flex;
        flex-direction: column;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.5), 0 4px 6px -2px rgba(0, 0, 0, 0.4);
        transition: all 0.3s ease;
    }
    
    .business-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.6), 0 10px 10px -5px rgba(0, 0, 0, 0.5);
        border-color: #2563EB;
    }

    .business-card.highlight {
        min-height: 360px;
    }

    .business-card .card-cover {
        height: 150px;
        background-size: cover;
        background-position: center;
        position: relative;
    }

    .business-card .card-cover::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,0.3) 100%);
    }

    .business-card .card-body {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: .75rem;
        color: #FFFFFF;
    }
    
    .business-card h3 {
        color: #FFFFFF !important;
        font-weight: 700;
        margin: 0;
    }
    
    .business-card p {
        color: #94A3B8 !important;
        margin: 0;
    }

    .card-badge {
        align-self: flex-start;
        padding: .35rem .85rem;
        border-radius: 999px;
        background: rgba(37, 99, 235, 0.15);
        border: 1px solid rgba(37, 99, 235, 0.3);
        color: #2563EB !important;
        font-size: .85rem;
        font-weight: 600;
    }

    .card-meta {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        font-size: .9rem;
        color: #94A3B8 !important;
    }

    .card-meta span {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        color: #94A3B8 !important;
    }

    .card-meta span i {
        color: #2563EB;
    }

    .trending-grid {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    }

    .business-card.compact {
        padding: 1rem 1.25rem;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .business-card.compact h3 {
        margin: 0;
        font-size: 1.1rem;
        color: #FFFFFF !important;
    }

    .business-card.compact p {
        margin: 0;
        color: #94A3B8 !important;
    }

    .business-card.compact .rating {
        text-align: right;
        color: #FFFFFF !important;
    }

    .business-card.compact .rating strong {
        color: #2563EB !important;
    }

    .results-grid {
        display: grid;
        gap: 1.2rem;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    }

    .business-card.basic .card-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
    }

    .business-card.basic h3 {
        margin: 0;
        font-size: 1.1rem;
        color: #FFFFFF !important;
    }

    .business-card.basic .muted {
        color: #94A3B8 !important;
        margin: 0;
    }

    .business-card.basic .address {
        margin: .75rem 0;
        color: #94A3B8 !important;
    }

    .business-card.basic .rating {
        text-align: right;
    }

    .business-card.basic .rating strong {
        color: #2563EB !important;
        font-size: 1.1rem;
    }

    .business-card.basic .rating span {
        color: #94A3B8 !important;
        font-size: 0.9rem;
    }

    .card-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
    }

    .card-actions .link {
        color: #2563EB !important;
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .card-actions .link:hover {
        color: #3B82F6 !important;
    }

    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        border-radius: 1.5rem;
        border: 2px dashed #334155;
        background: rgba(255, 255, 255, 0.02);
        color: #94A3B8;
    }

    .empty-state i {
        font-size: 3rem;
        color: #2563EB;
        margin-bottom: 1rem;
    }
    
    .empty-state h3 {
        color: #FFFFFF !important;
        margin-bottom: 0.5rem;
    }
    
    .empty-state p {
        color: #94A3B8 !important;
        margin: 0;
    }

    @@media (max-width: 768px) {
        .search-bar {
            padding: 1rem 0;
        }

        .search-bar .input-pill {
            border-radius: .9rem;
        }

        .filter-chips {
            gap: .5rem;
        }
    }
</style>

<script>
    // Filter chips - vanilla JS kullanıyoruz çünkü jQuery'den bağımsız
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.filter-chips .chip').forEach(chip => {
            chip.addEventListener('click', () => {
                const sort = chip.dataset.sort;
                const url = new URL(window.location.href);
                url.searchParams.set('sortBy', sort);
                window.location.href = url.toString();
            });
        });
    });

    // jQuery yüklendikten sonra çalışacak şekilde düzenle
    function initializeComparison() {
        // jQuery'nin yüklendiğinden emin ol
        if (typeof jQuery === 'undefined') {
            console.warn('jQuery yüklenmemiş, tekrar deneniyor...');
            setTimeout(initializeComparison, 100);
            return;
        }

        // jQuery'nin hazır olduğundan emin ol
        jQuery(document).ready(function($) {
            console.log('Karşılaştırma butonları başlatılıyor...');

            // Karşılaştırma butonu tıklama - karşılaştırma sayfasına yönlendirme ile
            $(document).on('click', '.compare-btn-search', function(e) {
                e.preventDefault();
                const $btn = $(this);
                const businessId = $btn.data('business-id');
                const isActive = $btn.hasClass('active');
                
                console.log('Karşılaştır butonu tıklandı (Search):', {
                    businessId: businessId,
                    isActive: isActive,
                    timestamp: new Date().toISOString()
                });

                if (!businessId) {
                    console.error('HATA: İşletme ID\'si bulunamadı');
                    showToast('Bir hata oluştu: İşletme ID\'si bulunamadı', 'error');
                    return;
                }

                // Eğer zaten aktifse (listede varsa), direkt karşılaştırma sayfasına git
                if (isActive) {
                    console.log('İşletme zaten listede, karşılaştırma sayfasına yönlendiriliyor...');
                    window.location.href = '/Compare/Index';
                    return;
                }

                // İşletmeyi karşılaştırmaya ekle ve karşılaştırma sayfasına yönlendir
                const token = $('input[name="__RequestVerificationToken"]').val();
                
                // Butonu geçici olarak devre dışı bırak
                $btn.prop('disabled', true);
                const originalHtml = $btn.html();
                $btn.html('<i class="fas fa-spinner fa-spin"></i>');
                
                $.ajax({
                    url: '/Compare/Add',
                    type: 'POST',
                    data: { businessId: businessId },
                    headers: token ? {
                        'RequestVerificationToken': token
                    } : {},
                    success: function(response) {
                        console.log('AJAX başarılı:', response);
                        
                        if (response && response.success) {
                            console.log('İşletme başarıyla eklendi, karşılaştırma sayfasına yönlendiriliyor...');
                            showToast(response.message || 'İşletme eklendi, karşılaştırma sayfasına yönlendiriliyor...', 'success');
                            
                            // 500ms sonra karşılaştırma sayfasına yönlendir
                            setTimeout(function() {
                                window.location.href = '/Compare/Index';
                            }, 500);
                        } else {
                            console.warn('AJAX uyarı:', response);
                            $btn.prop('disabled', false);
                            $btn.html(originalHtml);
                            showToast((response && response.message) || 'Bir hata oluştu', 'warning');
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('AJAX hatası:', {
                            xhr: xhr,
                            status: status,
                            error: error,
                            statusCode: xhr.status,
                            responseText: xhr.responseText
                        });
                        
                        // Butonu tekrar aktif et
                        $btn.prop('disabled', false);
                        $btn.html(originalHtml);
                        
                        let errorMessage = 'Bir hata oluştu: ' + (error || 'Bilinmeyen hata');
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMessage = xhr.responseJSON.message;
                        }
                        showToast(errorMessage, 'error');
                    }
                });
            });

            // Karşılaştırma durumunu kontrol et
            $('.compare-btn-search').each(function() {
                const businessId = $(this).data('business-id');
                const $btn = $(this);
                
                if (businessId) {
                    $.get('/Compare/Check?businessId=' + businessId, function(response) {
                        if (response && response.isInCompare) {
                            $btn.addClass('active');
                            $btn.html('<i class="fas fa-check"></i>');
                            $btn.removeClass('btn-outline-primary').addClass('btn-success');
                        }
                    }).fail(function(xhr, status, error) {
                        console.error('Karşılaştırma durumu kontrolü başarısız:', {
                            xhr: xhr,
                            status: status,
                            error: error
                        });
                    });
                }
            });

            // Karşılaştırma sayısını güncelle
            function updateCompareCount() {
                $.get('/Compare/GetCount', function(response) {
                    if ($('#compareCount').length) {
                        $('#compareCount').text(response.count || 0);
                    }
                }).fail(function(xhr, status, error) {
                    console.error('Karşılaştırma sayısı güncelleme başarısız:', {
                        xhr: xhr,
                        status: status,
                        error: error
                    });
                });
            }

            updateCompareCount();
            console.log('Karşılaştırma butonları başlatıldı');
        });
    }

    // jQuery yüklendikten sonra başlat
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeComparison);
    } else {
        // DOM zaten yüklü, hemen başlat
        initializeComparison();
    }

    function showToast(message, type) {
        if (typeof jQuery !== 'undefined') {
            const $ = jQuery;
            const toast = $('<div class="toast-notification toast-' + type + '">' + message + '</div>');
            $('body').append(toast);
            setTimeout(() => toast.fadeOut(() => toast.remove()), 3000);
        } else {
            // Fallback: vanilla JS
            const toast = document.createElement('div');
            toast.className = 'toast-notification toast-' + type;
            toast.textContent = message;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
        }
    }
</script>

