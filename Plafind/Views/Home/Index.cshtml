    .comparison-btn-text {
        font-weight: 600;
        margin-left: 0.25rem;
    }
</style>

@section Scripts {
    <script>
        (function () {
            function setButtonState($btn, isActive) {
                const $icon = $btn.find('i').first();
                const $text = $btn.find('.comparison-btn-text').first();

                if (isActive) {
                    $btn.addClass('active')
                        .removeClass('btn-outline-primary')
                        .addClass('btn-success');
                    $btn.attr('aria-pressed', 'true');
                    $btn.css({ border: '2px solid #198754', backgroundColor: '#198754', color: '#fff' });
                    $icon.removeClass('fa-balance-scale').addClass('fa-check');
                    $text.text('Eklendi ✓');
                } else {
                    $btn.removeClass('active')
                        .removeClass('btn-success')
                        .addClass('btn-outline-primary');
                    $btn.attr('aria-pressed', 'false');
                    $btn.css({ border: '2px solid #0d6efd', backgroundColor: 'transparent', color: '#0d6efd' });
                    $icon.removeClass('fa-check').addClass('fa-balance-scale');
                    $text.text('Karşılaştır');
                }
            }

            function showToast(message, type) {
                const cls = type === 'success' ? 'toast-success' : type === 'warning' ? 'toast-warning' : 'toast-error';
                const $toast = $('<div class="toast-notification ' + cls + '">' + message + '</div>');
                $('body').append($toast);
                setTimeout(() => $toast.fadeOut(250, () => $toast.remove()), 3000);
            }

            function updateCompareCount() {
                $.get('/Compare/GetCount', function (response) {
                    $('#compareCount').text(response.count);
                });
            }

            function syncButtonsFromServer() {
                $('.compare-btn-home').each(function () {
                    const $btn = $(this);
                    const businessId = $btn.data('business-id');
                    $.get('/Compare/Check?businessId=' + businessId, function (response) {
                        setButtonState($btn, !!response.isInCompare);
                    });
                });
            }

            $(document).ready(function () {
                // İlk yüklemede mevcut compare durumunu çek
                syncButtonsFromServer();
                updateCompareCount();

                // Tıklama: add/remove
                $(document).on('click', '.compare-btn-home', function (e) {
                    e.preventDefault();
                    const $btn = $(this);
                    const businessId = $btn.data('business-id');
                    
                    if (!businessId) {
                        console.error('Business ID bulunamadı!');
                        showToast('Bir hata oluştu: İşletme ID\'si bulunamadı', 'error');
                        return;
                    }
                    
                    const isActive = $btn.hasClass('active');
                    const token = $('input[name="__RequestVerificationToken"]').val() || $('input[name="__RequestVerificationToken"]').first().val();
                    
                    console.log('Karşılaştırma butonu tıklandı:', { businessId, isActive, token: !!token });

                    $.ajax({
                        url: isActive ? '/Compare/Remove' : '/Compare/Add',
                        type: 'POST',
                        data: { businessId: businessId },
                        headers: token ? {
                            'RequestVerificationToken': token
                        } : {},
                        success: function (response) {
                            console.log('AJAX başarılı:', response);
                            if (response && response.success) {
                                setButtonState($btn, !isActive);
                                updateCompareCount();
                                showToast(response.message || 'Güncellendi', 'success');
                            } else {
                                showToast((response && response.message) || 'Bir hata oluştu', 'warning');
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error('AJAX hatası:', { xhr, status, error });
                            showToast('Bir hata oluştu: ' + (error || 'Bilinmeyen hata'), 'error');
                        }
                    });
                });
            });
        })();
    </script>
    <style>
        .toast-notification {
            position: fixed;
            bottom: 20px;
            right: 20px;
            padding: 12px 16px;
            border-radius: 10px;
            color: white;
            z-index: 10000;
            box-shadow: 0 8px 24px rgba(0,0,0,0.25);
            font-weight: 600;
        }
        .toast-success { background: #198754; }
        .toast-warning { background: #ffc107; color: #111; }
        .toast-error { background: #dc3545; }
    </style>
}