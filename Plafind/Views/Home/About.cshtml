@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["AboutTitle"].Value + " - Alanya İşletme Rehberi";
}

<!-- Hero Section -->
<section class="about-hero py-5">
    <div class="container">
        <div class="row justify-content-center text-center mb-5">
            <div class="col-lg-8">
                <img src="~/images/Logo.png" alt="Alanya İşletme Rehberi Logo" class="about-logo mb-4" onerror="this.onerror=null; this.src='~/images/Logo.jpg';" />
                <h1 class="display-4 fw-bold mb-3">@Localizer["AboutTitle"]</h1>
                <p class="lead text-muted">@Localizer["AboutSubtitle"]</p>
            </div>
        </div>
    </div>
</section>

<!-- Mission & Vision -->
<section class="py-5">
    <div class="container">
        <div class="row g-4 mb-5">
            <div class="col-lg-6">
                <div class="glass-card h-100">
                    <div class="text-center mb-4">
                        <i class="fas fa-bullseye fa-3x text-warning mb-3"></i>
                        <h2 class="fw-bold mb-3">@Localizer["OurMission"]</h2>
                    </div>
                    <p class="text-justify lead">
                        @Localizer["MissionText"]
                    </p>
                    <ul class="list-unstyled mt-4">
                        <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>@Localizer["TransparentInfo"]</li>
                        <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>@Localizer["SupportLocal"]</li>
                        <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>@Localizer["UserExperience"]</li>
                        <li class="mb-0"><i class="fas fa-check-circle text-success me-2"></i>@Localizer["ContinuousImprovement"]</li>
                    </ul>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="glass-card h-100">
                    <div class="text-center mb-4">
                        <i class="fas fa-eye fa-3x text-info mb-3"></i>
                        <h2 class="fw-bold mb-3">@Localizer["OurVision"]</h2>
                    </div>
                    <p class="text-justify lead">
                        @Localizer["VisionText"]
                    </p>
                    <ul class="list-unstyled mt-4">
                        <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>@Localizer["RegionalLeadership"]</li>
                        <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>@Localizer["TechnologicalExcellence"]</li>
                        <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>@Localizer["SocialValue"]</li>
                        <li class="mb-0"><i class="fas fa-check-circle text-success me-2"></i>@Localizer["SustainableGrowth"]</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Values -->
        <div class="row mb-5">
            <div class="col-12">
                <div class="glass-card">
                    <div class="text-center mb-5">
                        <i class="fas fa-heart fa-3x text-danger mb-3"></i>
                        <h2 class="fw-bold mb-3">@Localizer["OurValues"]</h2>
                    </div>
                    <div class="row g-4">
                        <div class="col-md-4">
                            <div class="value-item text-center">
                                <div class="value-icon mb-3">
                                    <i class="fas fa-shield-alt fa-2x text-warning"></i>
                                </div>
                                <h5 class="fw-bold mb-2">@Localizer["Reliability"]</h5>
                                <p class="text-muted">@Localizer["ReliabilityText"]</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="value-item text-center">
                                <div class="value-icon mb-3">
                                    <i class="fas fa-users fa-2x text-primary"></i>
                                </div>
                                <h5 class="fw-bold mb-2">@Localizer["CustomerFocus"]</h5>
                                <p class="text-muted">@Localizer["CustomerFocusText"]</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="value-item text-center">
                                <div class="value-icon mb-3">
                                    <i class="fas fa-lightbulb fa-2x text-warning"></i>
                                </div>
                                <h5 class="fw-bold mb-2">@Localizer["Innovation"]</h5>
                                <p class="text-muted">@Localizer["InnovationText"]</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="value-item text-center">
                                <div class="value-icon mb-3">
                                    <i class="fas fa-handshake fa-2x text-success"></i>
                                </div>
                                <h5 class="fw-bold mb-2">@Localizer["Collaboration"]</h5>
                                <p class="text-muted">@Localizer["CollaborationText"]</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="value-item text-center">
                                <div class="value-icon mb-3">
                                    <i class="fas fa-balance-scale fa-2x text-info"></i>
                                </div>
                                <h5 class="fw-bold mb-2">@Localizer["Transparency"]</h5>
                                <p class="text-muted">@Localizer["TransparencyText"]</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="value-item text-center">
                                <div class="value-icon mb-3">
                                    <i class="fas fa-chart-line fa-2x text-warning"></i>
                                </div>
                                <h5 class="fw-bold mb-2">@Localizer["ContinuousDevelopment"]</h5>
                                <p class="text-muted">@Localizer["ContinuousDevelopmentText"]</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Statistics -->
        <div class="row mb-5">
            <div class="col-12">
                <div class="glass-card">
                    <div class="text-center mb-5">
                        <h2 class="fw-bold mb-3">@Localizer["ByNumbers"]</h2>
                        <p class="text-muted">@Localizer["ByNumbersSubtitle"]</p>
                    </div>
                    <div class="row g-4 text-center">
                        <div class="col-md-3 col-6">
                            <div class="stat-box">
                                <i class="fas fa-building fa-3x text-warning mb-3"></i>
                                <h3 class="fw-bold display-5 mb-2">650+</h3>
                                <p class="text-muted mb-0">@Localizer["Businesses"]</p>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="stat-box">
                                <i class="fas fa-users fa-3x text-primary mb-3"></i>
                                <h3 class="fw-bold display-5 mb-2">5000+</h3>
                                <p class="text-muted mb-0">@Localizer["ActiveUsers"]</p>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="stat-box">
                                <i class="fas fa-comments fa-3x text-success mb-3"></i>
                                <h3 class="fw-bold display-5 mb-2">2500+</h3>
                                <p class="text-muted mb-0">@Localizer["Reviews"]</p>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="stat-box">
                                <i class="fas fa-calendar-check fa-3x text-info mb-3"></i>
                                <h3 class="fw-bold display-5 mb-2">1200+</h3>
                                <p class="text-muted mb-0">@Localizer["Reservations"]</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contact CTA -->
        <div class="row">
            <div class="col-12">
                <div class="glass-card text-center bg-gradient">
                    <h3 class="fw-bold mb-3"><i class="fas fa-envelope me-2 text-warning"></i>@Localizer["ContactCTA"]</h3>
                    <p class="lead mb-4">@Localizer["ContactCTAText"]</p>
                    <a href="@Url.Action("Contact", "Home")" class="btn btn-primary btn-lg">
                        <i class="fas fa-paper-plane me-2"></i>@Localizer["GoToContact"]
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .about-hero {
        background: linear-gradient(135deg, rgba(7,17,38,0.95) 0%, rgba(7,17,38,0.85) 100%);
    }

    .about-logo {
        height: 120px;
        width: auto;
        object-fit: contain;
        max-width: 300px;
        filter: drop-shadow(0 6px 16px rgba(255,193,7,0.4));
    }

    .value-item {
        padding: 1.5rem;
        border-radius: 1rem;
        transition: all 0.3s ease;
    }

    .value-item:hover {
        background: rgba(255,193,7,0.1);
        transform: translateY(-5px);
    }

    .value-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255,193,7,0.1);
        border-radius: 50%;
    }

    .stat-box {
        padding: 2rem 1rem;
        border-radius: 1rem;
        transition: all 0.3s ease;
    }

    .stat-box:hover {
        background: rgba(255,193,7,0.1);
        transform: scale(1.05);
    }

    .bg-gradient {
        background: linear-gradient(135deg, rgba(255,193,7,0.1) 0%, rgba(255,193,7,0.05) 100%) !important;
        border: 2px solid rgba(255,193,7,0.2);
    }

    @@media (max-width: 768px) {
        .about-logo {
            height: 90px;
            max-width: 250px;
        }
    }
</style>

