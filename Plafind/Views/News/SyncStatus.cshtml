@model Plafind.Models.NewsSyncStatus
@{
    ViewData["Title"] = "Haber Senkronizasyon Durumu";
}

<div class="container py-5">
    <div class="row">
        <div class="col-12">
            <div class="page-header mb-4">
                <h1><i class="fas fa-sync-alt me-2"></i>Haber Senkronizasyon Durumu</h1>
                <p class="text-muted">Google News API'den haber çekme durumu ve istatistikleri</p>
            </div>

            <!-- Background Service Durumu -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-server me-2"></i>Background Service Durumu</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="status-item">
                                <span class="status-label">Durum:</span>
                                @if (Model.IsBackgroundServiceRunning)
                                {
                                    <span class="badge bg-success">
                                        <i class="fas fa-check-circle me-1"></i>Çalışıyor
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        <i class="fas fa-times-circle me-1"></i>Durdurulmuş
                                    </span>
                                }
                            </div>
                            @if (Model.ServiceStartTime.HasValue)
                            {
                                <div class="status-item">
                                    <span class="status-label">Başlangıç Zamanı:</span>
                                    <span class="status-value">@Model.ServiceStartTime.Value.ToString("dd.MM.yyyy HH:mm:ss")</span>
                                </div>
                            }
                            <div class="status-item">
                                <span class="status-label">Toplam Çalıştırma:</span>
                                <span class="status-value">@Model.ServiceTotalRuns kez</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            @if (Model.ServiceLastRunTime.HasValue)
                            {
                                <div class="status-item">
                                    <span class="status-label">Son Çalıştırma:</span>
                                    <span class="status-value">@Model.ServiceLastRunTime.Value.ToString("dd.MM.yyyy HH:mm:ss")</span>
                                </div>
                            }
                            <div class="status-item">
                                <span class="status-label">Senkronizasyon Periyodu:</span>
                                <span class="status-value">6 saat</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Son Senkronizasyon Durumu -->
            <div class="card shadow-sm mb-4">
                <div class="card-header @(Model.IsSuccess ? "bg-success" : "bg-danger") text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle me-2"></i>Son Senkronizasyon Durumu
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.LastSyncTime == DateTime.MinValue)
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            Henüz senkronizasyon yapılmamış.
                        </div>
                    }
                    else
                    {
                        <div class="row">
                            <div class="col-md-6">
                                <div class="status-item">
                                    <span class="status-label">Son Senkronizasyon:</span>
                                    <span class="status-value">@Model.LastSyncTime.ToString("dd.MM.yyyy HH:mm:ss")</span>
                                </div>
                                @if (Model.TimeSinceLastSync.HasValue)
                                {
                                    <div class="status-item">
                                        <span class="status-label">Geçen Süre:</span>
                                        <span class="status-value">
                                            @if (Model.TimeSinceLastSync.Value.TotalDays >= 1)
                                            {
                                                @($"{Model.TimeSinceLastSync.Value.Days} gün {Model.TimeSinceLastSync.Value.Hours} saat")
                                            }
                                            else if (Model.TimeSinceLastSync.Value.TotalHours >= 1)
                                            {
                                                @($"{Model.TimeSinceLastSync.Value.Hours} saat {Model.TimeSinceLastSync.Value.Minutes} dakika")
                                            }
                                            else
                                            {
                                                @($"{Model.TimeSinceLastSync.Value.Minutes} dakika")
                                            }
                                        </span>
                                    </div>
                                }
                                <div class="status-item">
                                    <span class="status-label">Durum:</span>
                                    @if (Model.IsSuccess)
                                    {
                                        <span class="badge bg-success">
                                            <i class="fas fa-check me-1"></i>Başarılı
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            <i class="fas fa-times me-1"></i>Başarısız
                                        </span>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="status-item">
                                    <span class="status-label">Eklenen Haber Sayısı:</span>
                                    <span class="status-value badge bg-info">@Model.LastSyncItemCount</span>
                                </div>
                                @if (Model.LastSyncDuration.HasValue)
                                {
                                    <div class="status-item">
                                        <span class="status-label">İşlem Süresi:</span>
                                        <span class="status-value">@($"{Model.LastSyncDuration.Value.TotalMilliseconds:F0} ms")</span>
                                    </div>
                                }
                                <div class="status-item">
                                    <span class="status-label">Toplam Senkronize Edilen:</span>
                                    <span class="status-value badge bg-primary">@Model.TotalSyncedItems</span>
                                </div>
                            </div>
                        </div>
                        
                        @if (!Model.IsSuccess && !string.IsNullOrEmpty(Model.LastErrorMessage))
                        {
                            <div class="alert alert-danger mt-3">
                                <strong><i class="fas fa-exclamation-circle me-2"></i>Hata Mesajı:</strong>
                                <p class="mb-0 mt-2">@Model.LastErrorMessage</p>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Hızlı İşlemler -->
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="fas fa-tools me-2"></i>Hızlı İşlemler</h5>
                </div>
                <div class="card-body">
                    <div class="btn-group" role="group">
                        <a href="@Url.Action("SyncTourismNews", "News")" class="btn btn-success">
                            <i class="fas fa-sync-alt me-2"></i>Şimdi Senkronize Et
                        </a>
                        <a href="@Url.Action("PreviewTourismNews", "News")" class="btn btn-info">
                            <i class="fas fa-eye me-2"></i>Haberleri Önizle
                        </a>
                        <a href="@Url.Action("Index", "News")" class="btn btn-primary">
                            <i class="fas fa-newspaper me-2"></i>Tüm Haberler
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .page-header {
        margin-bottom: 2rem;
    }

    .page-header h1 {
        font-size: 2.5rem;
        font-weight: 700;
        color: #2d3748;
        margin-bottom: 0.5rem;
    }

    .status-item {
        padding: 0.75rem 0;
        border-bottom: 1px solid #e2e8f0;
    }

    .status-item:last-child {
        border-bottom: none;
    }

    .status-label {
        font-weight: 600;
        color: #4a5568;
        display: inline-block;
        min-width: 180px;
    }

    .status-value {
        color: #2d3748;
        font-weight: 500;
    }

    .card {
        border-radius: 0.75rem;
        border: none;
    }

    .card-header {
        border-radius: 0.75rem 0.75rem 0 0 !important;
        font-weight: 600;
    }

    .badge {
        font-size: 0.875rem;
        padding: 0.5rem 0.75rem;
    }

    .alert {
        border-radius: 0.5rem;
    }

    @@media (max-width: 768px) {
        .page-header h1 {
            font-size: 2rem;
        }

        .status-label {
            min-width: auto;
            display: block;
            margin-bottom: 0.25rem;
        }

        .btn-group {
            flex-direction: column;
            width: 100%;
        }

        .btn-group .btn {
            width: 100%;
            margin-bottom: 0.5rem;
        }
    }
</style>

