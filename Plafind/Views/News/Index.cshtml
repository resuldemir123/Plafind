@model IEnumerable<Plafind.Models.News>
@{
    ViewData["Title"] = "Turizm Haberleri";
}

@section Styles {
    <link rel="stylesheet" href="~/css/news.css" asp-append-version="true" />
}

<div class="news-page-wrapper">
    <div class="container py-5">
        <!-- Hero Section -->
        <div class="news-hero-section mb-5">
            <div class="hero-content">
                <div class="hero-icon">
                    <i class="fas fa-newspaper"></i>
                </div>
                <div class="hero-text">
                    <h1 class="hero-title">
                        <i class="fas fa-umbrella-beach me-3"></i>
                        Turizm Haberleri
                    </h1>
                    <p class="hero-subtitle">Alanya'dan en güncel turizm haberleri, sezon bilgileri, etkinlikler ve turizm sektöründeki gelişmeler</p>
                </div>
            </div>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn-create-news">
                    <i class="fas fa-plus-circle me-2"></i>
                    <span>Yeni Haber Ekle</span>
                </a>
            }
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="news-grid">
                @foreach (var item in Model)
                {
                    <article class="news-card">
                        <!-- Image Section -->
                        <div class="news-card-image">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <a asp-action="Details" asp-route-id="@item.Id">
                                    <img src="@Url.Content(item.ImageUrl.StartsWith("/") ? "~" + item.ImageUrl : (item.ImageUrl.StartsWith("~/") ? item.ImageUrl : "~/" + item.ImageUrl))" 
                                         alt="@item.Title" 
                                         class="news-image">
                                    <div class="image-overlay">
                                        <span class="read-more-text">
                                            <i class="fas fa-arrow-right me-2"></i>Devamını Oku
                                        </span>
                                    </div>
                                </a>
                            }
                            else
                            {
                                <div class="news-placeholder">
                                    <i class="fas fa-newspaper"></i>
                                </div>
                            }
                            @if (item.PublishDate >= DateTime.Now.AddDays(-7))
                            {
                                <div class="news-badge">
                                    <i class="fas fa-fire me-1"></i>
                                    <span>Yeni</span>
                                </div>
                            }
                            @if (item.IsExternal)
                            {
                                <div class="news-external-badge">
                                    <i class="fas fa-rss me-1"></i>
                                    <span>@(item.ExternalSource ?? "RSS")</span>
                                </div>
                            }
                        </div>

                        <!-- Content Section -->
                        <div class="news-card-content">
                            <div class="news-meta-top">
                                <span class="news-date">
                                    <i class="fas fa-calendar-alt me-2"></i>
                                    @item.PublishDate.ToString("dd MMMM yyyy")
                                </span>
                                <span class="news-views">
                                    <i class="fas fa-eye me-2"></i>
                                    @(item.ViewCount ?? 0)
                                </span>
                            </div>

                            <h2 class="news-title">
                                <a asp-action="Details" asp-route-id="@item.Id" class="news-title-link">
                                    @item.Title
                                </a>
                            </h2>

                            <div class="news-excerpt">
                                @{
                                    // HTML etiketlerini temizle ve düz metin al
                                    var plainText = System.Text.RegularExpressions.Regex.Replace(
                                        item.Content ?? "", 
                                        "<.*?>", 
                                        string.Empty
                                    );
                                    plainText = System.Net.WebUtility.HtmlDecode(plainText);
                                    
                                    // Fazla boşlukları temizle
                                    plainText = System.Text.RegularExpressions.Regex.Replace(
                                        plainText, 
                                        @"\s+", 
                                        " "
                                    ).Trim();
                                    
                                    var excerpt = plainText.Length > 150
                                        ? plainText.Substring(0, 150) + "..."
                                        : plainText;
                                }
                                <p>@excerpt</p>
                            </div>

                            <div class="news-card-footer">
                                <div class="news-author">
                                    <div class="author-avatar">
                                        <i class="fas fa-user"></i>
                                    </div>
                                    <div class="author-info">
                                        <span class="author-name">@(item.Author?.DisplayName ?? item.Author?.UserName ?? (item.IsExternal ? item.ExternalSource ?? "Harici Kaynak" : "Admin"))</span>
                                        <span class="author-role">@(item.IsExternal ? "Harici Kaynak" : "Yazar")</span>
                                    </div>
                                </div>
                                @if (item.IsExternal && !string.IsNullOrEmpty(item.SourceUrl))
                                {
                                    <div class="news-source-badge">
                                        <i class="fas fa-external-link-alt me-1"></i>
                                        <span>Harici</span>
                                    </div>
                                }

                                <div class="news-actions">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn-read-more">
                                        <span>Oku</span>
                                        <i class="fas fa-arrow-right ms-2"></i>
                                    </a>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <div class="admin-actions">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-admin-edit" title="Düzenle">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" 
                                               class="btn-admin-delete" 
                                               title="Sil"
                                               onclick="return confirm('Bu haberi silmek istediğinizden emin misiniz?');">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="empty-news-state">
                <div class="empty-icon">
                    <i class="fas fa-newspaper"></i>
                </div>
                <h3 class="empty-title">Henüz haber bulunmamaktadır</h3>
                <p class="empty-description">Yakında yeni haberler eklenecektir.</p>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Create" class="btn-create-first">
                        <i class="fas fa-plus-circle me-2"></i>
                        İlk Haberi Oluştur
                    </a>
                }
            </div>
        }
    </div>
</div>
