@model IEnumerable<Plafind.Models.Review>
@{
    ViewData["Title"] = "İşletme Yorumları";
    var business = ViewBag.Business as Plafind.Models.Business;
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold" style="color: var(--text-title);">
                        <i class="fas fa-comments me-2" style="color: var(--color-primary);"></i>İşletme Yorumları
                    </h2>
                    <p class="mb-0" style="color: var(--text-muted);">
                        @business?.Name için yapılan yorumlar
                    </p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Geri Dön
                </a>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- İşletme Bilgileri -->
            @if (business != null)
            {
                <div class="card shadow-sm mb-4" style="background: var(--bg-surface); border-color: var(--border-color);">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <h5 class="mb-1" style="color: var(--text-title);">@business.Name</h5>
                                <p class="text-muted mb-0 small">
                                    <i class="fas fa-map-marker-alt me-1"></i>@business.Address
                                </p>
                            </div>
                            <div class="col-md-4 text-end">
                                <div class="mb-2">
                                    <span class="badge" style="background: var(--color-warning-soft); color: var(--color-warning);">
                                        <i class="fas fa-star me-1"></i>@business.AverageRating.ToString("F1") / 5.0
                                    </span>
                                </div>
                                <div>
                                    <small style="color: var(--text-muted);">
                                        <i class="fas fa-comment me-1"></i>@Model.Count() yorum
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Yorumlar Listesi -->
            @if (!Model.Any())
            {
                <div class="card shadow-sm" style="background: var(--bg-surface); border-color: var(--border-color);">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-comment-slash fa-3x mb-3" style="color: var(--text-muted);"></i>
                        <p class="mb-0" style="color: var(--text-muted);">Henüz yorum yapılmamış.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var review in Model)
                    {
                        <div class="col-12">
                            <div class="card shadow-sm" style="background: var(--bg-surface); border-color: var(--border-color);">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="avatar rounded-circle d-flex align-items-center justify-content-center" 
                                                 style="width: 50px; height: 50px; background: var(--color-primary-soft);">
                                                <i class="fas fa-user" style="color: var(--color-primary);"></i>
                                            </div>
                                            <div>
                                                <h6 class="mb-0" style="color: var(--text-title);">
                                                    @(review.User?.FullName ?? review.User?.UserName ?? "Anonim Kullanıcı")
                                                </h6>
                                                <small style="color: var(--text-muted);">
                                                    @review.CreatedDate.ToString("dd MMMM yyyy HH:mm")
                                                </small>
                                            </div>
                                        </div>
                                        <div class="text-end">
                                            <div class="mb-1">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    if (i <= review.Rating)
                                                    {
                                                        <i class="fas fa-star" style="color: var(--color-warning);"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="far fa-star" style="color: var(--text-muted);"></i>
                                                    }
                                                }
                                            </div>
                                            <span class="badge" style="background: var(--color-primary-soft); color: var(--color-primary);">
                                                @review.Rating / 5
                                            </span>
                                        </div>
                                    </div>
                                    
                                    @if (!string.IsNullOrEmpty(review.Comment))
                                    {
                                        <div class="review-comment" style="color: var(--text-body); line-height: 1.6;">
                                            @review.Comment
                                        </div>
                                    }
                                    
                                    <div class="mt-3 pt-3 border-top" style="border-color: var(--border-color);">
                                        <div class="d-flex gap-2">
                                            @if (review.IsApproved)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="fas fa-check-circle me-1"></i>Onaylandı
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">
                                                    <i class="fas fa-clock me-1"></i>Onay Bekliyor
                                                </span>
                                            }
                                            @if (review.IsActive)
                                            {
                                                <span class="badge bg-info">
                                                    <i class="fas fa-eye me-1"></i>Aktif
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">
                                                    <i class="fas fa-eye-slash me-1"></i>Pasif
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<style>
    .review-comment {
        font-size: 1rem;
        white-space: pre-wrap;
    }
    
    .avatar {
        flex-shrink: 0;
    }
</style>

