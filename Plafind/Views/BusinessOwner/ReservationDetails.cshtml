                alert(data.message || 'Bir hata oluştu');
            }
        });
    }

    function showCheckInOutModal() {
        new bootstrap.Modal(document.getElementById('checkInOutModal')).show();
    }

    function saveCheckInOut() {
        const checkInDate = document.getElementById('checkInDate').value;
        const checkInTime = document.getElementById('checkInTime').value;
        const checkOutDate = document.getElementById('checkOutDate').value;
        const checkOutTime = document.getElementById('checkOutTime').value;
        const tourStartTime = document.getElementById('tourStartTime').value;
        const tourEndTime = document.getElementById('tourEndTime').value;
        
        let checkInTimeSpan = null;
        if (checkInTime) {
            const [hours, minutes] = checkInTime.split(':');
            checkInTimeSpan = `${hours}:${minutes}:00`;
        }
        
        let checkOutTimeSpan = null;
        if (checkOutTime) {
            const [hours, minutes] = checkOutTime.split(':');
            checkOutTimeSpan = `${hours}:${minutes}:00`;
        }
        
        fetch('@Url.Action("UpdateCheckInOut")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({
                id: reservationId,
                checkInDate: checkInDate || null,
                checkInTime: checkInTimeSpan,
                checkOutDate: checkOutDate || null,
                checkOutTime: checkOutTimeSpan,
                tourStartTime: tourStartTime || null,
                tourEndTime: tourEndTime || null
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert(data.message);
                location.reload();
            } else {
                alert(data.message || 'Bir hata oluştu');
            }
        });
    }

