@model IEnumerable<Plafind.Models.Reservation>

@{
    var business = ViewBag.Business as Plafind.Models.Business;
    var year = ViewBag.Year as int? ?? DateTime.Now.Year;
    var month = ViewBag.Month as int? ?? DateTime.Now.Month;
    var reservations = ViewBag.Reservations as List<Plafind.Models.Reservation> ?? new List<Plafind.Models.Reservation>();
    ViewData["Title"] = "Takvim Görünümü - " + (business?.Name ?? "");
}

<section class="py-4">
    <div class="container-fluid px-3 px-md-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold">Takvim Görünümü</h2>
                <p class="text-muted mb-0">@business?.Name - @year/@month</p>
            </div>
            <div>
                <a asp-action="ReservationsAdvanced" asp-route-businessId="@business?.Id" class="btn btn-outline-primary me-2">
                    <i class="fas fa-list me-1"></i>Liste Görünümü
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i>İşletmelerime Dön
                </a>
            </div>
        </div>

        <!-- Ay Navigasyonu -->
        <div class="card mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <a href="@Url.Action("ReservationsCalendar", new { businessId = business?.Id, year = month == 1 ? year - 1 : year, month = month == 1 ? 12 : month - 1 })" 
                       class="btn btn-outline-primary">
                        <i class="fas fa-chevron-left me-1"></i>Önceki Ay
                    </a>
                    <h4 class="mb-0">@(new DateTime(year, month, 1).ToString("MMMM yyyy", new System.Globalization.CultureInfo("tr-TR")))</h4>
                    <a href="@Url.Action("ReservationsCalendar", new { businessId = business?.Id, year = month == 12 ? year + 1 : year, month = month == 12 ? 1 : month + 1 })" 
                       class="btn btn-outline-primary">
                        Sonraki Ay <i class="fas fa-chevron-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Takvim -->
        <div class="card">
            <div class="card-body">
                <div id="calendar"></div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
<link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/locales/tr.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const reservations = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(reservations.Select(r => new {
            id = r.Id,
            title = $"{r.NumberOfPeople} kişi - {r.Status}",
            start = r.RequestedDate.ToString("yyyy-MM-dd") + "T" + r.RequestedTime.ToString(@"hh\:mm\:ss"),
            color = r.Status == "Onaylandı" ? "#28a745" : r.Status == "İptal Edildi" ? "#dc3545" : r.IsNoShow ? "#000000" : "#ffc107",
            url = Url.Action("ReservationDetails", new { id = r.Id })
        }))));

        const calendarEl = document.getElementById('calendar');
        const calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            initialDate: '@year-@month.ToString("00")-01',
            locale: 'tr',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,timeGridDay'
            },
            events: reservations,
            eventClick: function(info) {
                info.jsEvent.preventDefault();
                window.location.href = info.event.url;
            },
            dayMaxEvents: true,
            moreLinkClick: 'popover'
        });
        calendar.render();
    });
</script>
}

