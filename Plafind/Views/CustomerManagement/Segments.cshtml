@{
    ViewData["Title"] = "Müşteri Segmentasyonu";
    var business = ViewBag.Business as Plafind.Models.Business;
    var businessId = ViewBag.BusinessId as int?;
    var segments = ViewBag.Segments as Dictionary<string, List<Plafind.ViewModels.CustomerInfo>> ?? new Dictionary<string, List<Plafind.ViewModels.CustomerInfo>>();
    var userBusinesses = ViewBag.UserBusinesses as List<Plafind.Models.Business> ?? new List<Plafind.Models.Business>();
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="mb-0">
                    <i class="fas fa-chart-pie me-2"></i>Müşteri Segmentasyonu
                </h2>
                @if (userBusinesses.Count > 1)
                {
                    <div class="dropdown">
                        <button class="btn btn-outline-primary dropdown-toggle" type="button" id="businessDropdown" data-bs-toggle="dropdown">
                            <i class="fas fa-building me-2"></i>
                            @(business?.Name ?? "İşletme Seçin")
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="businessDropdown">
                            @foreach (var b in userBusinesses)
                            {
                                <li>
                                    <a class="dropdown-item @(b.Id == businessId ? "active" : "")" 
                                       href="@Url.Action("Segments", new { businessId = b.Id })">
                                        @b.Name
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>
    </div>

    @if (business != null)
    {
        <!-- Segment İstatistikleri -->
        <div class="row mb-4">
            @{
                var segmentNames = new Dictionary<string, string> 
                { 
                    { "VIP", "VIP Müşteriler" },
                    { "Regular", "Düzenli Müşteriler" },
                    { "New", "Yeni Müşteriler" },
                    { "AtRisk", "Risk Altındaki Müşteriler" }
                };
                var segmentColors = new Dictionary<string, string>
                {
                    { "VIP", "danger" },
                    { "Regular", "primary" },
                    { "New", "success" },
                    { "AtRisk", "warning" }
                };
            }
            
            @foreach (var segmentKey in segmentNames.Keys)
            {
                var segmentCustomers = segments.ContainsKey(segmentKey) ? segments[segmentKey] : new List<Plafind.ViewModels.CustomerInfo>();
                var totalRevenue = segmentCustomers.Sum(c => c.TotalSpent);
                var avgSpending = segmentCustomers.Any() ? totalRevenue / segmentCustomers.Count : 0;
                
                <div class="col-md-3 mb-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <h6 class="text-muted mb-2">@segmentNames[segmentKey]</h6>
                            <h3 class="mb-0 text-@segmentColors[segmentKey]">@segmentCustomers.Count</h3>
                            <small class="text-muted">
                                Toplam: @totalRevenue.ToString("C")<br />
                                Ortalama: @avgSpending.ToString("C")
                            </small>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Segment Detayları -->
        @foreach (var segmentKey in segmentNames.Keys)
        {
            var segmentCustomers = segments.ContainsKey(segmentKey) ? segments[segmentKey] : new List<Plafind.ViewModels.CustomerInfo>();
            
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-@segmentColors[segmentKey] text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-users me-2"></i>@segmentNames[segmentKey] (@segmentCustomers.Count)
                    </h5>
                </div>
                <div class="card-body">
                    @if (segmentCustomers.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Müşteri</th>
                                        <th>Rezervasyon</th>
                                        <th>Toplam Harcama</th>
                                        <th>Son Ziyaret</th>
                                        <th>İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var customer in segmentCustomers)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    @if (!string.IsNullOrEmpty(customer.AvatarUrl))
                                                    {
                                                        <img src="@customer.AvatarUrl" class="rounded-circle me-2" 
                                                             style="width: 40px; height: 40px; object-fit: cover;" />
                                                    }
                                                    else
                                                    {
                                                        <div class="bg-primary text-white rounded-circle me-2 d-flex align-items-center justify-content-center" 
                                                             style="width: 40px; height: 40px;">
                                                            @customer.FullName?.Substring(0, 1).ToUpper()
                                                        </div>
                                                    }
                                                    <div>
                                                        <strong>@customer.FullName</strong>
                                                        <br />
                                                        <small class="text-muted">@customer.Email</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>@customer.TotalReservations</td>
                                            <td>@customer.TotalSpent.ToString("C")</td>
                                            <td>
                                                @if (customer.LastVisitDate.HasValue)
                                                {
                                                    @customer.LastVisitDate.Value.ToString("dd MMM yyyy")
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                <a href="@Url.Action("Details", new { customerId = customer.UserId, businessId = businessId })" 
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-eye"></i> Detay
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center">Bu segmentte müşteri bulunmamaktadır.</p>
                    }
                </div>
            </div>
        }
    }
</div>
