@model IEnumerable<News>
@{
    ViewData["Title"] = "Haberler";
}

<div class="page-header">
    <h1>📦 Haberler</h1>
    <p>Haber içeriklerini yönetin</p>
    <div class="mt-3">
        <a href="@Url.Action("SyncTourismNews", "News")" class="btn btn-success">
            <i class="fas fa-sync-alt me-2"></i>
            Turizm Haberlerini Senkronize Et
        </a>
        <a href="@Url.Action("PreviewTourismNews", "News")" class="btn btn-info ms-2">
            <i class="fas fa-eye me-2"></i>
            Turizm Haberlerini Önizle
        </a>
        <a href="@Url.Action("SyncStatus", "News")" class="btn btn-warning ms-2">
            <i class="fas fa-chart-line me-2"></i>
            Senkronizasyon Durumu
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Başlık</th>
                            <th>Yazar</th>
                            <th>Kaynak</th>
                            <th>Yayın Tarihi</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var news in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@news.Title</strong>
                                    @if (news.IsExternal)
                                    {
                                        <span class="badge bg-info ms-2">Harici</span>
                                    }
                                </td>
                                <td>@(news.Author?.UserName ?? "Sistem")</td>
                                <td>
                                    @if (news.IsExternal && !string.IsNullOrEmpty(news.ExternalSource))
                                    {
                                        <span class="badge bg-secondary">@news.ExternalSource</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@news.PublishDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <a href="@Url.Action("Details", "News", new { id = news.Id })" class="btn btn-sm btn-primary" title="Görüntüle">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    @if (!news.IsExternal)
                                    {
                                        <a href="@Url.Action("Edit", "News", new { id = news.Id })" class="btn btn-sm btn-warning ms-1" title="Düzenle">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-newspaper fa-3x text-muted mb-3"></i>
                <p class="text-muted">Haber bulunmamaktadır.</p>
            </div>
        }
    </div>
</div>

