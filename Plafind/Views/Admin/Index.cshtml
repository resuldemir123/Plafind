@{
    ViewData["Title"] = "Admin Dashboard";
    var stats = ViewBag.Stats as dynamic;
}

<style>
    .stat-card {
        border: 1px solid var(--border-color);
        border-radius: 15px;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-md);
        background: var(--bg-surface);
    }
    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-xl);
    }
    .stat-card-primary {
        background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-hover) 100%);
        color: white;
        border-color: var(--color-primary);
    }
    .stat-card-success {
        background: linear-gradient(135deg, var(--color-success) 0%, #16A34A 100%);
        color: white;
        border-color: var(--color-success);
    }
    .stat-card-warning {
        background: linear-gradient(135deg, var(--color-warning) 0%, #D97706 100%);
        color: white;
        border-color: var(--color-warning);
    }
    .stat-card-info {
        background: linear-gradient(135deg, var(--color-info) 0%, #0EA5E9 100%);
        color: white;
        border-color: var(--color-info);
    }
    .stat-icon {
        font-size: 3rem;
        opacity: 0.3;
    }
    .dashboard-card {
        border: 1px solid var(--border-color);
        border-radius: 15px;
        box-shadow: var(--shadow-md);
        margin-bottom: 2rem;
        background: var(--bg-surface);
    }
    .dashboard-card-header {
        background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-hover) 100%);
        color: white;
        border-radius: 15px 15px 0 0 !important;
        padding: 1.25rem;
        border: none;
    }
    .dashboard-card .card-body {
        background: var(--bg-surface);
        color: var(--text-default);
    }
    .page-header h1 {
        color: var(--text-default);
    }
    .page-header p {
        color: var(--text-muted);
    }
</style>

<div class="page-header">
    <h1>📊 Dashboard & Analytics</h1>
    <p>Sistem genel bakış, istatistikler ve hızlı erişim</p>
</div>

    <!-- İstatistikler -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card stat-card-primary h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="mb-2 fw-semibold text-white-50 small text-uppercase">Toplam İşletme</p>
                            <h2 class="mb-0 fw-bold">@stats.TotalBusinesses</h2>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-building"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card stat-card stat-card-success h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="mb-2 fw-semibold text-white-50 small text-uppercase">Aktif İşletme</p>
                            <h2 class="mb-0 fw-bold">@stats.ActiveBusinesses</h2>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-check-circle"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card stat-card stat-card-warning h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="mb-2 fw-semibold text-white-50 small text-uppercase">Bekleyen Onay</p>
                            <h2 class="mb-0 fw-bold">@stats.PendingApprovals</h2>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-clock"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card stat-card stat-card-info h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="mb-2 fw-semibold text-white-50 small text-uppercase">Toplam Kullanıcı</p>
                            <h2 class="mb-0 fw-bold">@stats.TotalUsers</h2>
                        </div>
                        <div class="stat-icon">
                            <i class="fas fa-users"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modüler Hızlı Erişim -->
    <div class="row g-4 mb-4">
        <div class="col-lg-4 col-md-6">
            <div class="card dashboard-card h-100">
                <div class="card-header dashboard-card-header">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-users me-2"></i>👥 User Management</h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("Users", "Admin")" class="btn btn-outline-primary btn-sm text-start">
                            <i class="fas fa-users me-2"></i>Kullanıcı Listesi
                        </a>
                        <a href="@Url.Action("BannedUsers", "Admin")" class="btn btn-outline-danger btn-sm text-start">
                            <i class="fas fa-ban me-2"></i>Banlı Kullanıcılar
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="card dashboard-card h-100">
                <div class="card-header" style="background: linear-gradient(135deg, var(--color-success) 0%, #16A34A 100%); color: white; border-radius: 15px 15px 0 0;">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-user-tag me-2"></i>🛡 Role & Permission</h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("Roles", "Admin")" class="btn btn-outline-success btn-sm text-start">
                            <i class="fas fa-user-tag me-2"></i>Roller
                        </a>
                        <a href="@Url.Action("AssignRoles", "Admin")" class="btn btn-outline-success btn-sm text-start">
                            <i class="fas fa-user-check me-2"></i>Rol Atama
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="card dashboard-card h-100">
                <div class="card-header dashboard-card-header">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-box me-2"></i>📦 Content Management</h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("Businesses", "Admin")" class="btn btn-outline-primary btn-sm text-start">
                            <i class="fas fa-building me-2"></i>İşletmeler
                        </a>
                        <a href="@Url.Action("Categories", "Admin")" class="btn btn-outline-primary btn-sm text-start">
                            <i class="fas fa-tags me-2"></i>Kategoriler
                        </a>
                        <a href="@Url.Action("Reviews", "Admin")" class="btn btn-outline-warning btn-sm text-start">
                            <i class="fas fa-comments me-2"></i>Yorumlar
                            @if (stats?.PendingReviews > 0)
                            {
                                <span class="badge bg-danger ms-2">@stats.PendingReviews</span>
                            }
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="card dashboard-card h-100">
                <div class="card-header" style="background: linear-gradient(135deg, var(--color-warning) 0%, #D97706 100%); color: white; border-radius: 15px 15px 0 0;">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-chart-line me-2"></i>📊 Analytics</h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("Analytics", "Admin")" class="btn btn-outline-warning btn-sm text-start">
                            <i class="fas fa-chart-line me-2"></i>İstatistikler
                        </a>
                        <a href="@Url.Action("Reports", "Admin")" class="btn btn-outline-warning btn-sm text-start">
                            <i class="fas fa-file-alt me-2"></i>Raporlar
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="card dashboard-card h-100">
                <div class="card-header" style="background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-hover) 100%); color: white; border-radius: 15px 15px 0 0;">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-cog me-2"></i>🛠 System Settings</h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("Settings", "Admin")" class="btn btn-outline-secondary btn-sm text-start">
                            <i class="fas fa-cog me-2"></i>Site Ayarları
                        </a>
                        <a href="@Url.Action("EmailSettings", "Admin")" class="btn btn-outline-secondary btn-sm text-start">
                            <i class="fas fa-envelope me-2"></i>E-posta SMTP
                        </a>
                        <a href="@Url.Action("Backup", "Admin")" class="btn btn-outline-secondary btn-sm text-start">
                            <i class="fas fa-database me-2"></i>Backup
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="card dashboard-card h-100">
                <div class="card-header" style="background: linear-gradient(135deg, var(--color-info) 0%, #0EA5E9 100%); color: white; border-radius: 15px 15px 0 0;">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-images me-2"></i>📂 Media Manager</h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("Media", "Admin")" class="btn btn-outline-info btn-sm text-start">
                            <i class="fas fa-images me-2"></i>Medya Yönetimi
                        </a>
                        <a href="@Url.Action("Upload", "Admin")" class="btn btn-outline-info btn-sm text-start">
                            <i class="fas fa-upload me-2"></i>Dosya Yükle
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="card dashboard-card h-100">
                <div class="card-header" style="background: linear-gradient(135deg, var(--text-muted) 0%, #64748B 100%); color: white; border-radius: 15px 15px 0 0;">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-list-alt me-2"></i>📝 Logs & Tracking</h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("Logs", "Admin")" class="btn btn-outline-dark btn-sm text-start">
                            <i class="fas fa-list-alt me-2"></i>Sistem Logları
                        </a>
                        <a href="@Url.Action("ActivityLog", "Admin")" class="btn btn-outline-dark btn-sm text-start">
                            <i class="fas fa-history me-2"></i>Aktivite Takibi
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6">
            <div class="card dashboard-card h-100">
                <div class="card-header" style="background: linear-gradient(135deg, var(--color-danger) 0%, #DC2626 100%); color: white; border-radius: 15px 15px 0 0;">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-inbox me-2"></i>💬 Feedback & Support</h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("Messages", "Admin")" class="btn btn-outline-danger btn-sm text-start">
                            <i class="fas fa-inbox me-2"></i>Kullanıcı Mesajları
                        </a>
                        <a href="@Url.Action("Tickets", "Admin")" class="btn btn-outline-danger btn-sm text-start">
                            <i class="fas fa-ticket-alt me-2"></i>Destek Biletleri
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Son Aktiviteler -->
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card dashboard-card h-100">
                <div class="card-header dashboard-card-header">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-history me-2"></i>Son Kullanıcı Aktivitesi</h5>
                </div>
                <div class="card-body p-4">
                    @if (ViewBag.RecentActivities != null && ((List<Plafind.Models.Review>)ViewBag.RecentActivities).Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var activity in (List<Plafind.Models.Review>)ViewBag.RecentActivities)
                            {
                                <div class="list-group-item border-0 px-0 py-3" style="background: transparent; border-color: var(--border-color);">
                                    <div class="d-flex align-items-start">
                                        <div class="avatar rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; background: var(--color-primary-soft);">
                                            <i class="fas fa-user" style="color: var(--color-primary);"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between align-items-start mb-1">
                                                <h6 class="mb-0 fw-semibold" style="color: var(--text-default);">@activity.User?.FullName</h6>
                                                <small style="color: var(--text-muted);">@activity.CreatedDate.ToString("dd.MM.yyyy HH:mm")</small>
                                            </div>
                                            <p class="mb-1 small" style="color: var(--text-muted);">@activity.Business?.Name için yorum yaptı</p>
                                            <div class="d-flex align-items-center">
                                                <span class="badge me-2" style="background: var(--color-warning-soft); color: var(--color-warning);">@activity.Rating/5</span>
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    if (i <= activity.Rating)
                                                    {
                                                        <i class="fas fa-star" style="font-size: 0.75rem; color: var(--color-warning);"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="far fa-star" style="font-size: 0.75rem; color: var(--text-muted);"></i>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                @if (activity != ((List<Plafind.Models.Review>)ViewBag.RecentActivities).Last())
                                {
                                    <hr class="my-2" style="border-color: var(--border-color);">
                                }
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-inbox fa-3x mb-3" style="color: var(--text-muted);"></i>
                            <p class="mb-0" style="color: var(--text-muted);">Henüz aktivite yok</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
