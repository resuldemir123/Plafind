@model IEnumerable<Plafind.Models.Business>

@{
    ViewData["Title"] = "Silinen İşletmeler";
}

<div class="admin-businesses-page">
    <div class="container-fluid">
        <div class="page-header-admin">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h3 mb-2 fw-bold text-dark">
                        <i class="fas fa-trash-restore me-2 text-danger"></i>Silinen İşletmeler
                    </h1>
                    <p class="text-muted mb-0">Soft delete yapılmış işletmeleri görüntüleyin ve geri yükleyin</p>
                </div>
                <a href="@Url.Action("Businesses")" class="btn btn-outline-primary">
                    <i class="fas fa-arrow-left me-2"></i>İşletme Listesine Dön
                </a>
            </div>
        </div>

        <div class="business-table-card">
            <div class="table-header-custom">
                <h5 class="mb-0 fw-bold">
                    <i class="fas fa-list me-2"></i>Silinen İşletme Listesi
                    <span class="badge bg-light text-dark ms-2">@Model.Count()</span>
                </h5>
            </div>
            <div class="table-responsive">
                <table class="table table-custom">
                    <thead>
                        <tr>
                            <th>İşletme Adı</th>
                            <th>Kategori</th>
                            <th>Silme Tarihi</th>
                            <th>Silen</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var business in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@business.Name</td>
                                    <td>
                                        @if (business.Category != null)
                                        {
                                            <span class="badge bg-info">@business.Category.Name</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Kategori Yok</span>
                                        }
                                    </td>
                                    <td>
                                        @if (business.DeletedDate.HasValue)
                                        {
                                            <span>@business.DeletedDate.Value.ToString("dd.MM.yyyy HH:mm")</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(business.DeletedBy))
                                        {
                                            <span class="badge bg-secondary">@business.DeletedBy</span>
                                        }
                                    </td>
                                    <td>
                                        <form asp-action="RestoreBusiness" method="post" style="display: inline;">
                                            <input type="hidden" name="id" value="@business.Id" />
                                            <button type="submit" class="btn btn-success btn-sm"
                                                    onclick="return confirm('Bu işletmeyi geri yüklemek istediğinizden emin misiniz?')"
                                                    title="Geri Yükle">
                                                <i class="fas fa-undo me-1"></i>Geri Yükle
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                                    <p class="text-muted">Silinen işletme bulunmamaktadır.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin-businesses.css" asp-append-version="true" />
}

