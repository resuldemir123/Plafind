@model IEnumerable<Plafind.Models.Review>

@{
    ViewData["Title"] = "Yorumlar";
    var businessId = ViewBag.BusinessId as int?;
    var sortBy = ViewBag.SortBy as string ?? "newest";
    var minRating = ViewBag.MinRating as int?;
    var maxRating = ViewBag.MaxRating as int?;
    var withPhotosOnly = ViewBag.WithPhotosOnly as bool?;
}

@section Styles {
    <link rel="stylesheet" href="~/css/reviews.css" />
}

<div class="reviews-page">
    <div class="container">
        <!-- Header -->
        <div class="reviews-header">
            <h1>Yorumlar</h1>
            <p class="text-muted">@Model.Count() yorum bulundu</p>
        </div>

        <!-- Filters -->
        <div class="reviews-filters">
            <form method="get" class="filter-form">
                <input type="hidden" name="businessId" value="@businessId" />
                
                <div class="filter-row">
                    <div class="filter-group">
                        <label for="sortBy" class="filter-label">Sıralama</label>
                        <select id="sortBy" name="sortBy" class="form-select" onchange="this.form.submit()">
                            @if (sortBy == "newest")
                            {
                                <option value="newest" selected>En Yeni</option>
                            }
                            else
                            {
                                <option value="newest">En Yeni</option>
                            }
                            @if (sortBy == "mosthelpful")
                            {
                                <option value="mosthelpful" selected>En Yararlı</option>
                            }
                            else
                            {
                                <option value="mosthelpful">En Yararlı</option>
                            }
                            @if (sortBy == "highest")
                            {
                                <option value="highest" selected>En Yüksek Puan</option>
                            }
                            else
                            {
                                <option value="highest">En Yüksek Puan</option>
                            }
                            @if (sortBy == "lowest")
                            {
                                <option value="lowest" selected>En Düşük Puan</option>
                            }
                            else
                            {
                                <option value="lowest">En Düşük Puan</option>
                            }
                            @if (sortBy == "mostliked")
                            {
                                <option value="mostliked" selected>En Çok Beğenilen</option>
                            }
                            else
                            {
                                <option value="mostliked">En Çok Beğenilen</option>
                            }
                        </select>
                    </div>

                    <div class="filter-group">
                        <label class="filter-label">
                            <input type="checkbox" 
                                   name="withPhotosOnly" 
                                   value="true"
                                   @(withPhotosOnly == true ? "checked" : "")
                                   onchange="this.form.submit()">
                            Sadece Fotoğraflı Yorumlar
                        </label>
                    </div>

                    <div class="filter-group">
                        <label for="minRating" class="filter-label">Puan Filtresi</label>
                        <div class="rating-range">
                            <input type="number" 
                                   id="minRating" 
                                   name="minRating" 
                                   class="form-control" 
                                   placeholder="Min" 
                                   min="1" 
                                   max="5"
                                   value="@minRating"
                                   onchange="this.form.submit()">
                            <span>-</span>
                            <input type="number" 
                                   id="maxRating" 
                                   name="maxRating" 
                                   class="form-control" 
                                   placeholder="Max" 
                                   min="1" 
                                   max="5"
                                   value="@maxRating"
                                   onchange="this.form.submit()">
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <!-- Reviews List -->
        <div class="reviews-list">
            @if (Model != null && Model.Any())
            {
                @foreach (var review in Model)
                {
                    <div class="review-card">
                        <div class="review-header">
                            <div class="review-user">
                                <div class="user-avatar">
                                    @if (!string.IsNullOrEmpty(review.User?.AvatarUrl))
                                    {
                                        <img src="@review.User.AvatarUrl" alt="@review.User.FullName" />
                                    }
                                    else
                                    {
                                        <i class="fas fa-user"></i>
                                    }
                                </div>
                                <div class="user-info">
                                    <h4>@(review.User?.FullName ?? review.User?.DisplayName ?? "Anonim Kullanıcı")</h4>
                                    <span class="review-date">@review.CreatedDate.ToString("dd MMMM yyyy")</span>
                                </div>
                            </div>
                            <div class="review-rating">
                                <div class="stars">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="@(i <= review.Rating ? "fas" : "far") fa-star"></i>
                                    }
                                </div>
                                <span class="rating-value">@review.Rating</span>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(review.Comment))
                        {
                            <div class="review-comment">
                                <p>@review.Comment</p>
                            </div>
                        }

                        @if (review.Images != null && review.Images.Any())
                        {
                            <div class="review-images">
                                <div class="image-grid">
                                    @foreach (var image in review.Images.Where(i => i.IsActive).Take(4))
                                    {
                                        <div class="review-image-item">
                                            <img src="@image.ImageUrl" 
                                                 alt="@(image.Caption ?? "Yorum fotoğrafı")" 
                                                 onclick="openImageModal('@image.ImageUrl', '@(image.Caption ?? "")')" />
                                        </div>
                                    }
                                    @if (review.Images.Count(i => i.IsActive) > 4)
                                    {
                                        <div class="review-image-item image-more">
                                            <span>+@(review.Images.Count(i => i.IsActive) - 4)</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <div class="review-footer">
                            <div class="review-actions">
                                <button class="btn-like" data-review-id="@review.Id" data-is-like="true">
                                    <i class="fas fa-thumbs-up"></i>
                                    <span>Yararlı (@review.HelpfulCount)</span>
                                </button>
                                <button class="btn-dislike" data-review-id="@review.Id" data-is-like="false">
                                    <i class="fas fa-thumbs-down"></i>
                                    <span>Yararsız (@review.DislikeCount)</span>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-reviews">
                    <i class="fas fa-comment-slash"></i>
                    <h3>Henüz yorum yok</h3>
                    <p>İlk yorumu siz yapın!</p>
                    <a asp-action="Create" asp-route-businessId="@businessId" class="btn btn-primary">
                        Yorum Yap
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Image Modal -->
<div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="imageModalLabel">Yorum Fotoğrafı</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body text-center">
                <img id="modalImage" src="" alt="" class="img-fluid" />
                <p id="modalCaption" class="mt-3 text-muted"></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openImageModal(imageUrl, caption) {
            document.getElementById('modalImage').src = imageUrl;
            document.getElementById('modalCaption').textContent = caption;
            const modal = new bootstrap.Modal(document.getElementById('imageModal'));
            modal.show();
        }

        // Like/Dislike functionality
        document.querySelectorAll('.btn-like, .btn-dislike').forEach(btn => {
            btn.addEventListener('click', async function() {
                const reviewId = this.dataset.reviewId;
                const isLike = this.dataset.isLike === 'true';
                
                try {
                    const response = await fetch('@Url.Action("Like", "Reviews")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        },
                        body: JSON.stringify({ reviewId: parseInt(reviewId), isLike: isLike })
                    });
                    
                    const result = await response.json();
                    if (result.success) {
                        // Update counts
                        location.reload();
                    }
                } catch (error) {
                    console.error('Error:', error);
                }
            });
        });
    </script>
}
