@model Plafind.Features.Reviews.ViewModels.CreateReviewViewModel

@{
    ViewData["Title"] = "Yeni Yorum Ekle";
    var businessId = ViewBag.BusinessId as int? ?? Model.BusinessId;
}

@section Styles {
    <link rel="stylesheet" href="~/css/review-create.css" />
}

<div class="review-create-page">
    <div class="container">
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="breadcrumb-nav">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Ana Sayfa</a></li>
                <li class="breadcrumb-item"><a asp-controller="Businesses" asp-action="Details" asp-route-id="@businessId">İşletme Detay</a></li>
                <li class="breadcrumb-item"><a asp-action="Index" asp-route-businessId="@businessId">Yorumlar</a></li>
                <li class="breadcrumb-item active">Yeni Yorum</li>
            </ol>
        </nav>

        <!-- Header -->
        <div class="review-header">
            <h1>Yeni Yorum Ekle</h1>
            <p class="text-muted">İşletme hakkındaki deneyimlerinizi paylaşın</p>
        </div>

        @if (!User.IsInRole("Admin"))
        {
            <form asp-action="Create" method="post" enctype="multipart/form-data" id="reviewForm">
                <input type="hidden" asp-for="BusinessId" value="@businessId" />
                
                <div class="review-form-card">
                    <!-- Rating Section -->
                    <div class="form-section">
                        <label class="section-label">
                            <i class="fas fa-star"></i>
                            Puan Verin <span class="text-danger">*</span>
                        </label>
                        <div class="rating-input-group">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <label class="rating-option">
                                    @if (i == 5)
                                    {
                                        <input type="radio" 
                                               asp-for="Rating" 
                                               value="@i" 
                                               checked 
                                               required />
                                    }
                                    else
                                    {
                                        <input type="radio" 
                                               asp-for="Rating" 
                                               value="@i" 
                                               required />
                                    }
                                    <div class="rating-display">
                                        <div class="stars">
                                            @for (int j = 1; j <= 5; j++)
                                            {
                                                <i class="@(j <= i ? "fas" : "far") fa-star"></i>
                                            }
                                        </div>
                                        <span class="rating-text">@i / 5</span>
                                    </div>
                                </label>
                            }
                        </div>
                        <span asp-validation-for="Rating" class="text-danger"></span>
                    </div>

                    <!-- Comment Section -->
                    <div class="form-section">
                        <label asp-for="Comment" class="section-label">
                            <i class="fas fa-comment"></i>
                            Yorumunuz <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="Comment" 
                                  class="form-control review-comment-input" 
                                  rows="6"
                                  placeholder="İşletme hakkındaki deneyimlerinizi, memnun kaldığınız veya geliştirilmesini istediğiniz noktaları yazın..."
                                  required></textarea>
                        <div class="form-text">
                            <i class="fas fa-info-circle"></i>
                            Yorumunuz diğer kullanıcılar için yol gösterici olacaktır.
                        </div>
                        <span asp-validation-for="Comment" class="text-danger"></span>
                    </div>

                    <!-- Images Section -->
                    <div class="form-section">
                        <label class="section-label">
                            <i class="fas fa-images"></i>
                            Fotoğraflar (Opsiyonel)
                        </label>
                        <div class="image-upload-area" id="imageUploadArea">
                            <input type="file" 
                                   id="imageInput" 
                                   name="Images" 
                                   multiple 
                                   accept="image/*"
                                   class="d-none" />
                            <div class="upload-placeholder" onclick="document.getElementById('imageInput').click()">
                                <i class="fas fa-cloud-upload-alt"></i>
                                <p>Fotoğraf eklemek için tıklayın veya sürükleyin</p>
                                <small>Maksimum 5 fotoğraf, her biri en fazla 5MB</small>
                            </div>
                            <div class="image-preview-container" id="imagePreviewContainer"></div>
                        </div>
                        <div class="form-text">
                            <i class="fas fa-info-circle"></i>
                            Fotoğraflı yorumlar daha çok dikkat çeker ve diğer kullanıcılar için daha yararlıdır.
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="form-actions">
                        <a asp-action="Index" asp-route-businessId="@businessId" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Geri Dön
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i>Yorumu Kaydet
                        </button>
                    </div>
                </div>
            </form>
        }
        else
        {
            <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle me-2"></i>
                Admin hesapları yorum oluşturamaz. Yalnızca gelen yorumları görüntüleyebilirsiniz.
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/review-create.js"></script>
}
