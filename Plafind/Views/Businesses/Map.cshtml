@model IEnumerable<Plafind.Models.Business>
@{
    ViewData["Title"] = "Harita - İşletmeler";
    var businesses = Model?.Where(b => b.IsActive && b.IsApproved).ToList() ?? new List<Plafind.Models.Business>();
}

<section class="map-shell">
    <!-- Harita Paneli -->
    <div class="map-panel">
        <div class="map-header">
            <h2 class="map-title">
                <i class="fas fa-map-marked-alt me-2"></i>
                Alanya İşletme Haritası
            </h2>
            <p class="map-subtitle">İşletmeleri haritada keşfedin ve konumlarını görüntüleyin</p>
        </div>
        <div id="businessMap" class="map-canvas" aria-label="İşletme haritası"></div>
        <div id="mapStatus" class="map-status d-none">
            <div class="map-status-content">
            <i class="fas fa-map-marker-alt"></i>
                <h4>Harita Hazırlanıyor</h4>
                <p>İşletme konumları yükleniyor...</p>
        </div>
    </div>
    </div>
    
    <!-- AI Asistan Paneli -->
    <div class="ai-panel">
        <div class="ai-card">
            <div class="ai-header">
                <div class="ai-header-content">
                    <div class="ai-icon-wrapper">
                        <i class="fas fa-robot"></i>
                    </div>
                        <div>
                        <h3 class="ai-title">AI Asistan</h3>
                        <p class="ai-subtitle">Konuma göre öneri alın</p>
                        </div>
                </div>
                <button type="button" id="aiLocationBtn" class="btn-location">
                    <i class="fas fa-location-arrow"></i>
                    <span>Konumum</span>
                        </button>
                    </div>
            
                    <div id="aiLocationInfo" class="ai-location-info d-none">
                <i class="fas fa-check-circle"></i>
                <span>Konum bilgisi eklendi</span>
                    </div>
            
                    <div id="aiMessages" class="ai-messages">
                        <div class="ai-message assistant">
                    <div class="message-avatar">
                        <i class="fas fa-robot"></i>
                        </div>
                    <div class="message-content">
                        <p>Merhaba! Bulunduğunuz bölgeye göre restoran, otel veya aktivite önerileri sunabilirim. Ne aradığınızı yazabilirsiniz.</p>
                    </div>
                </div>
            </div>
            
                    <form id="aiForm" class="ai-input">
                <div class="input-wrapper">
                    <textarea id="aiPrompt" class="form-control" rows="3" placeholder="Örn: Konaklı'da çocukla gidilebilecek restoran önerir misiniz?"></textarea>
                    <button type="submit" id="aiSendBtn" class="btn-send">
                        <i class="fas fa-paper-plane"></i>
                            </button>
                        </div>
                <div class="ai-actions">
                    <small id="aiStatus" class="ai-status">Hazır</small>
                        </div>
                    </form>
        </div>
    </div>
</section>

<style>
    /* Dark Mode - Harita Sayfası */
    /* Ana Container */
    .map-shell {
        min-height: calc(100vh - 80px);
        background: linear-gradient(135deg, #0B1220 0%, #1E293B 50%, #0B1220 100%);
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
        gap: 1.5rem;
        padding: 2rem;
        margin-top: 80px;
    }

    /* Harita Paneli */
    .map-panel {
        position: relative;
        background: #1E293B;
        border-radius: 16px;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.5), 0 4px 6px -2px rgba(0, 0, 0, 0.4);
        border: 1px solid #334155;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        min-height: 600px;
    }

    .map-header {
        padding: 1.5rem 2rem;
        background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
        color: #FFFFFF;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .map-title {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0 0 0.5rem 0;
        color: #FFFFFF !important;
        display: flex;
        align-items: center;
    }

    .map-title i {
        font-size: 1.75rem;
        margin-right: 0.75rem;
        color: #FFFFFF;
    }

    .map-subtitle {
        font-size: 0.9375rem;
        margin: 0;
        color: rgba(255, 255, 255, 0.9) !important;
        font-weight: 400;
    }

    .map-canvas {
        flex: 1;
        width: 100%;
        min-height: 500px;
        position: relative;
        background: #0B1220;
    }

    /* TomTom Harita Dark Mode Overlay */
    .map-canvas .tt-map {
        filter: brightness(0.8) contrast(1.1);
    }

    /* TomTom kontrol butonları dark mode */
    .map-canvas .tt-control-container {
        filter: invert(1) hue-rotate(180deg);
    }

    .map-canvas .tt-control-container button {
        background: #1E293B !important;
        border-color: #334155 !important;
        color: #FFFFFF !important;
    }

    .map-status {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(30, 41, 59, 0.95);
        backdrop-filter: blur(10px);
        z-index: 1000;
        border-radius: 16px;
    }

    .map-status-content {
        text-align: center;
        padding: 2rem;
    }

    .map-status-content i {
        font-size: 3rem;
        color: #2563EB;
        margin-bottom: 1rem;
        display: block;
    }

    .map-status-content h4 {
        font-size: 1.25rem;
        font-weight: 600;
        color: #FFFFFF !important;
        margin: 0 0 0.5rem 0;
    }

    .map-status-content p {
        font-size: 0.9375rem;
        color: #94A3B8 !important;
        margin: 0;
    }

    /* AI Panel */
    .ai-panel {
        display: flex;
        flex-direction: column;
    }

    .ai-card {
        background: #1E293B;
        border-radius: 16px;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.5), 0 4px 6px -2px rgba(0, 0, 0, 0.4);
        border: 1px solid #334155;
        padding: 0;
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
    }

    .ai-header {
        padding: 1.5rem;
        background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
        color: #FFFFFF;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .ai-header-content {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex: 1;
    }

    .ai-icon-wrapper {
        width: 48px;
        height: 48px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .ai-icon-wrapper i {
        font-size: 1.5rem;
        color: #FFFFFF;
    }

    .ai-title {
        font-size: 1.25rem;
        font-weight: 700;
        margin: 0;
        color: #FFFFFF !important;
    }

    .ai-subtitle {
        font-size: 0.875rem;
        margin: 0.25rem 0 0 0;
        color: rgba(255, 255, 255, 0.9) !important;
        font-weight: 400;
    }

    .btn-location {
        background: rgba(255, 255, 255, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.3);
        color: #FFFFFF;
        padding: 0.625rem 1rem;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        white-space: nowrap;
    }

    .btn-location:hover {
        background: rgba(255, 255, 255, 0.3);
        transform: translateY(-1px);
    }

    .ai-location-info {
        padding: 0.75rem 1.5rem;
        background: rgba(22, 163, 74, 0.15);
        border-left: 4px solid #16A34A;
        color: #FFFFFF !important;
        font-size: 0.875rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0 1.5rem;
        border-radius: 0 0 8px 8px;
    }

    .ai-location-info i {
        color: #16A34A;
    }

    .ai-messages {
        flex: 1;
        padding: 1.5rem;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        background: #0B1220;
        min-height: 300px;
        max-height: 400px;
    }

    .ai-message {
        display: flex;
        gap: 0.75rem;
        align-items: flex-start;
        animation: fadeIn 0.3s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .ai-message.assistant {
        align-self: flex-start;
    }

    .ai-message.user {
        align-self: flex-end;
        flex-direction: row-reverse;
    }

    .message-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .ai-message.assistant .message-avatar {
        background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
        color: #FFFFFF;
    }

    .ai-message.user .message-avatar {
        background: linear-gradient(135deg, #14B8A6 0%, #0D9488 100%);
        color: #FFFFFF;
    }

    .message-content {
        flex: 1;
        padding: 0.875rem 1rem;
        border-radius: 12px;
        font-size: 0.9375rem;
        line-height: 1.6;
        max-width: 85%;
    }

    .ai-message.assistant .message-content {
        background: #1E293B;
        color: #FFFFFF !important;
        border: 1px solid #334155;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    }

    .ai-message.user .message-content {
        background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
        color: #FFFFFF !important;
        box-shadow: 0 2px 8px rgba(37, 99, 235, 0.3);
    }

    .message-content p {
        margin: 0;
        color: inherit !important;
    }

    /* Input Alanı */
    .ai-input {
        padding: 1.5rem;
        background: #1E293B;
        border-top: 1px solid #334155;
    }

    .input-wrapper {
        position: relative;
        display: flex;
        gap: 0.75rem;
        align-items: flex-end;
    }

    .ai-input textarea {
        flex: 1;
        padding: 0.875rem 1rem;
        border: 2px solid #334155;
        border-radius: 12px;
        font-size: 0.9375rem;
        color: #FFFFFF !important;
        background: rgba(255, 255, 255, 0.05);
        resize: none;
        transition: all 0.3s ease;
        font-family: inherit;
    }

    .ai-input textarea:focus {
        outline: none;
        border-color: #2563EB;
        background: rgba(255, 255, 255, 0.08);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
        color: #FFFFFF !important;
    }

    .ai-input textarea::placeholder {
        color: #94A3B8 !important;
        opacity: 0.7;
    }

    .btn-send {
        width: 44px;
        height: 44px;
        background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
        border: none;
        border-radius: 12px;
        color: white;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        flex-shrink: 0;
    }

    .btn-send:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.4);
        background: linear-gradient(135deg, #1D4ED8 0%, #1E40AF 100%);
    }

    .btn-send:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .ai-actions {
        margin-top: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: flex-end;
    }

    .ai-status {
        font-size: 0.8125rem;
        color: #94A3B8 !important;
        font-style: italic;
    }

    /* Responsive */
    @@media (max-width: 1200px) {
        .map-shell {
            grid-template-columns: 1.5fr 1fr;
            gap: 1rem;
            padding: 1.5rem;
        }
    }

    @@media (max-width: 992px) {
        .map-shell {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }

        .map-panel {
            min-height: 500px;
        }

        .ai-card {
            min-height: 500px;
        }
    }

    @@media (max-width: 768px) {
        .map-shell {
            padding: 1rem;
            margin-top: 70px;
        }

        .map-header {
            padding: 1.25rem 1.5rem;
        }

        .map-title {
            font-size: 1.25rem;
        }

        .map-subtitle {
            font-size: 0.875rem;
        }

        .ai-header {
            padding: 1.25rem;
            flex-wrap: wrap;
        }

        .ai-title {
            font-size: 1.125rem;
        }

        .btn-location span {
            display: none;
        }

        .ai-messages {
            padding: 1rem;
            min-height: 250px;
            max-height: 300px;
        }

        .ai-input {
            padding: 1rem;
        }
    }

    @@media (max-width: 576px) {
        .map-shell {
            padding: 0.75rem;
        }

        .map-header {
            padding: 1rem;
        }

        .map-title {
            font-size: 1.125rem;
        }

        .map-title i {
            font-size: 1.5rem;
        }

        .ai-header {
            padding: 1rem;
        }

        .ai-icon-wrapper {
            width: 40px;
            height: 40px;
        }

        .message-content {
            max-width: 90%;
            font-size: 0.875rem;
        }
    }

    /* Scrollbar Styling - Dark Mode */
    .ai-messages::-webkit-scrollbar {
        width: 6px;
    }

    .ai-messages::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
    }

    .ai-messages::-webkit-scrollbar-thumb {
        background: #334155;
        border-radius: 10px;
    }

    .ai-messages::-webkit-scrollbar-thumb:hover {
        background: #475569;
    }

    /* Map Popup Styling - Dark Mode */
    .map-popup {
        min-width: 280px;
        max-width: 320px;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        background: #1E293B;
        color: #FFFFFF;
        padding: 0.5rem;
        border-radius: 12px;
    }

    .popup-header {
        margin-bottom: 0.75rem;
    }

    .popup-title {
        font-size: 1.125rem;
        font-weight: 700;
        color: #FFFFFF !important;
        margin: 0 0 0.5rem 0;
        line-height: 1.4;
    }

    .popup-category {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
        color: #FFFFFF !important;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .popup-address {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        margin: 0.75rem 0;
        padding: 0.5rem;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 8px;
        font-size: 0.875rem;
        color: #94A3B8 !important;
        line-height: 1.5;
    }

    .popup-address i {
        color: #2563EB;
        margin-top: 0.125rem;
        flex-shrink: 0;
    }

    .popup-stats {
        display: flex;
        gap: 1rem;
        margin: 0.75rem 0;
        padding-top: 0.75rem;
        border-top: 1px solid #334155;
    }

    .popup-stat {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        font-size: 0.875rem;
        color: #94A3B8 !important;
    }

    .popup-stat i {
        color: #2563EB;
        font-size: 0.875rem;
    }

    .popup-stat:last-child i {
        color: #14B8A6;
    }

    .popup-button {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        width: 100%;
        padding: 0.75rem 1rem;
        background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
        color: #FFFFFF !important;
        text-decoration: none;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 600;
        transition: all 0.3s ease;
        margin-top: 0.75rem;
    }

    .popup-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.4);
        background: linear-gradient(135deg, #1D4ED8 0%, #1E40AF 100%);
        color: #FFFFFF !important;
    }

    .popup-button i {
        font-size: 0.75rem;
        transition: transform 0.3s ease;
    }

    .popup-button:hover i {
        transform: translateX(2px);
    }
</style>

@section Scripts {
    <script>
        const mapStatus = document.getElementById('mapStatus');
        const markers = {};
        const defaultCenter = { lat: 36.5437, lng: 31.9995 };
        let googleMap;
        let infoWindow;

        window.initBusinessMap = function () {
            if (!document.getElementById('businessMap')) {
                return;
            }

            googleMap = new google.maps.Map(document.getElementById('businessMap'), {
                zoom: 12,
                center: defaultCenter,
                mapId: 'DEMO_MAP_ID',
                mapTypeControl: true,
                streetViewControl: true,
                styles: [
                    { elementType: 'geometry', stylers: [{ color: '#0B1220' }] },
                    { elementType: 'labels.text.stroke', stylers: [{ color: '#0B1220' }] },
                    { elementType: 'labels.text.fill', stylers: [{ color: '#94A3B8' }] },
                    {
                        featureType: 'water',
                        elementType: 'geometry',
                        stylers: [{ color: '#1E293B' }]
                    },
                    {
                        featureType: 'road',
                        elementType: 'geometry',
                        stylers: [{ color: '#334155' }]
                    }
                ]
            });

            infoWindow = new google.maps.InfoWindow();
            loadBusinessMarkers();
        };

        // Geocoding ile adres bilgisinden koordinat bul
        function geocodeAddress(address, callback) {
            if (!window.google || !window.google.maps) {
                // Google Maps yoksa OpenStreetMap Nominatim kullan
                if (address) {
                    fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(address + ', Alanya, Antalya')}&limit=1`)
                        .then(response => response.json())
                        .then(data => {
                            if (data && data.length > 0) {
                                callback({
                                    lat: parseFloat(data[0].lat),
                                    lng: parseFloat(data[0].lon)
                                });
                            } else {
                                callback(null);
                            }
                        })
                        .catch(() => callback(null));
                } else {
                    callback(null);
                }
                return;
            }

            const geocoder = new google.maps.Geocoder();
            geocoder.geocode({ address: address + ', Alanya, Antalya' }, (results, status) => {
                if (status === 'OK' && results && results[0]) {
                    const location = results[0].geometry.location;
                    callback({
                        lat: location.lat(),
                        lng: location.lng()
                    });
                } else {
                    callback(null);
                }
            });
        }

        // Varsayılan konum etrafında rastgele dağıt (Alanya merkez)
        function getDefaultLocation(index, total) {
            const centerLat = 36.5437;
            const centerLng = 31.9995;
            const radius = 0.05; // ~5km yarıçap
            const angle = (index / total) * 2 * Math.PI;
            const distance = radius * Math.sqrt(Math.random());
            
            return {
                lat: centerLat + distance * Math.cos(angle),
                lng: centerLng + distance * Math.sin(angle)
            };
        }

        function loadBusinessMarkers() {
            fetch('@Url.Action("Locations", "Businesses")')
                .then(response => response.json())
                .then(data => {
                    if (!Array.isArray(data) || data.length === 0) {
                        mapStatus?.classList.remove('d-none');
                        return;
                    }

                    mapStatus?.classList.add('d-none');
                    const bounds = new google.maps.LatLngBounds();
                    let markerCount = 0;
                    let firstMarkerAdded = false;

                    function addMarker(item, position, index) {
                        if (!position) return;

                        markerCount++;

                        const marker = new google.maps.Marker({
                            position,
                            map: googleMap,
                            title: item.name ?? 'İşletme',
                            icon: {
                                url: 'http://maps.google.com/mapfiles/ms/icons/red-dot.png',
                                scaledSize: new google.maps.Size(32, 32)
                            }
                        });

                        const popup = `
                            <div class="map-popup">
                                <div class="popup-header">
                                    <h4 class="popup-title">${item.name ?? 'İşletme'}</h4>
                                    ${item.category ? `<span class="popup-category">${item.category}</span>` : ''}
                                </div>
                                ${item.address ? `
                                    <div class="popup-address">
                                        <i class="fas fa-map-marker-alt"></i>
                                        <span>${item.address}</span>
                                </div>
                                ` : ''}
                                <div class="popup-stats">
                                    <div class="popup-stat">
                                        <i class="fas fa-star"></i>
                                        <span>${(item.averageRating ?? 0).toFixed(1)}</span>
                                    </div>
                                    <div class="popup-stat">
                                        <i class="fas fa-comment"></i>
                                        <span>${item.totalReviews ?? 0}</span>
                                    </div>
                                </div>
                                <a href="/Businesses/Details/${item.id}" class="popup-button">
                                    <span>Detayları Gör</span>
                                    <i class="fas fa-arrow-right"></i>
                                </a>
                            </div>`;

                        marker.addListener('click', () => {
                            infoWindow.setContent(popup);
                            infoWindow.open(googleMap, marker);
                        });

                        markers[item.id] = marker;
                        bounds.extend(position);

                        // İlk işletme için yakın yerleri göster
                        if (!firstMarkerAdded && window.NearbyPlacesService) {
                            firstMarkerAdded = true;
                            window.NearbyPlacesService.showNearbyPlaces(googleMap, position, item.name || 'İşletme', true);
                        }
                    }

                    function finalizeMap() {
                        if (bounds.isEmpty()) {
                            googleMap.setCenter(defaultCenter);
                            googleMap.setZoom(12);
                        } else {
                            googleMap.fitBounds(bounds);
                            // Eğer çok yakınlaştıysa zoom seviyesini ayarla
                            if (window.google && window.google.maps) {
                                google.maps.event.addListenerOnce(googleMap, 'bounds_changed', function() {
                                    if (googleMap.getZoom() > 15) {
                                        googleMap.setZoom(15);
                                    }
                                });
                            }
                        }
                    }

                    // Önce koordinatı olanları ekle, sonra adres bilgisi olanları geocoding yap
                    const itemsWithCoords = [];
                    const itemsNeedingGeocoding = [];

                    data.forEach((item, index) => {
                        if (item.hasCoordinates && item.latitude && item.longitude) {
                            const lat = parseFloat(item.latitude);
                            const lng = parseFloat(item.longitude);
                            if (!Number.isNaN(lat) && !Number.isNaN(lng)) {
                                itemsWithCoords.push({ item, position: { lat, lng }, index });
                            } else if (item.address) {
                                itemsNeedingGeocoding.push({ item, index });
                            } else {
                                itemsNeedingGeocoding.push({ item, index });
                            }
                        } else if (item.address) {
                            itemsNeedingGeocoding.push({ item, index });
                        } else {
                            itemsNeedingGeocoding.push({ item, index });
                        }
                    });

                    // Koordinatı olanları hemen ekle
                    itemsWithCoords.forEach(({ item, position, index }) => {
                        addMarker(item, position, index);
                    });

                    // Adres bilgisi olanları geocoding yap
                    let geocodingCompleted = 0;
                    itemsNeedingGeocoding.forEach(({ item, index }) => {
                        if (item.address) {
                            geocodeAddress(item.address, (coords) => {
                                geocodingCompleted++;
                                if (coords) {
                                    addMarker(item, coords, index);
                                } else {
                                    // Geocoding başarısız olursa varsayılan konum kullan
                                    const defaultPos = getDefaultLocation(index, data.length);
                                    addMarker(item, defaultPos, index);
                                }
                                
                                if (geocodingCompleted === itemsNeedingGeocoding.length) {
                                    finalizeMap();
                                }
                            });
                        } else {
                            geocodingCompleted++;
                            // Ne koordinat ne de adres varsa varsayılan konum
                            const defaultPos = getDefaultLocation(index, data.length);
                            addMarker(item, defaultPos, index);
                            
                            if (geocodingCompleted === itemsNeedingGeocoding.length) {
                                finalizeMap();
                            }
                        }
                    });

                    // Eğer sadece koordinatı olanlar varsa hemen finalize et
                    if (itemsNeedingGeocoding.length === 0) {
                        finalizeMap();
                    }
                })
                .catch(() => mapStatus?.classList.remove('d-none'));
        }

            const aiForm = document.getElementById('aiForm');
            const aiPrompt = document.getElementById('aiPrompt');
            const aiMessages = document.getElementById('aiMessages');
            const aiStatus = document.getElementById('aiStatus');
            const aiSendBtn = document.getElementById('aiSendBtn');
            const aiLocationBtn = document.getElementById('aiLocationBtn');
            const aiLocationInfo = document.getElementById('aiLocationInfo');
            let lastLocation = null;
            let isSending = false;

            function appendMessage(role, text) {
                const wrapper = document.createElement('div');
                wrapper.classList.add('ai-message', role);
                
                const avatar = document.createElement('div');
                avatar.classList.add('message-avatar');
                avatar.innerHTML = role === 'assistant' 
                    ? '<i class="fas fa-robot"></i>' 
                    : '<i class="fas fa-user"></i>';
                
                const content = document.createElement('div');
                content.classList.add('message-content');
                content.innerHTML = `<p>${text}</p>`;
                
                wrapper.appendChild(avatar);
                wrapper.appendChild(content);
                aiMessages.appendChild(wrapper);
                aiMessages.scrollTop = aiMessages.scrollHeight;
            }

            function setStatus(message) {
                if (aiStatus) {
                    aiStatus.textContent = message;
                }
            }

            aiLocationBtn?.addEventListener('click', () => {
                if (!navigator.geolocation) {
                    setStatus('Tarayıcınız konum paylaşımını desteklemiyor.');
                    return;
                }

                setStatus('Konum alınıyor...');
                navigator.geolocation.getCurrentPosition(
                    (position) => {
                        lastLocation = {
                            latitude: position.coords.latitude,
                            longitude: position.coords.longitude
                        };
                        aiLocationInfo?.classList.remove('d-none');
                        setStatus('Konum eklendi, sorunuzu yazabilirsiniz.');
                    },
                    () => setStatus('Konum izni reddedildi veya alınamadı.')
                );
            });

            aiForm?.addEventListener('submit', async (event) => {
                event.preventDefault();
                if (isSending) return;

                const prompt = aiPrompt?.value.trim();
                if (!prompt) {
                    setStatus('Lütfen bir soru yazın.');
                    return;
                }

                appendMessage('user', prompt);
                aiPrompt.value = '';

                isSending = true;
                aiSendBtn.disabled = true;
                setStatus('Gemini yanıtı hazırlanıyor...');

                try {
                    const response = await fetch('/api/ai/chat', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            prompt,
                            latitude: lastLocation?.latitude,
                            longitude: lastLocation?.longitude
                        })
                    });

                    if (!response.ok) {
                        throw new Error('İstek başarısız');
                    }

                    const data = await response.json();
                    appendMessage('assistant', data.response ?? 'Yanıt alınamadı.');
                    setStatus('Yeni sorular sorabilirsiniz.');
                } catch (error) {
                    appendMessage('assistant', 'Şu an cevap veremiyorum. Lütfen tekrar deneyin.');
                    setStatus('Bir sorun oluştu.');
                } finally {
                    isSending = false;
                    aiSendBtn.disabled = false;
                }
            });
    </script>
    <script src="~/js/nearby-places.js" asp-append-version="true"></script>
    @{
        var tomTomApiKey = ViewBag.TomTomApiKey as string ?? "";
        var googleMapsApiKey = ViewBag.GoogleMapsApiKey as string ?? "";
        var apiKeyJson = !string.IsNullOrEmpty(tomTomApiKey) ? System.Text.Json.JsonSerializer.Serialize(tomTomApiKey) : "\"\"";
    }
    
    @if (!string.IsNullOrEmpty(tomTomApiKey))
    {
        <!-- TomTom Maps API -->
        <link rel="stylesheet" type="text/css" href="https://api.tomtom.com/maps-sdk-for-web/cdn/6.x/6.25.0/maps/maps.css" />
        <script>
            // TomTom API key'i global olarak ayarla
            window.tomtomApiKey = @Html.Raw(apiKeyJson);
            
            // Debug için
            if (window.tomtomApiKey && window.tomtomApiKey.length > 0) {
                var keyPreview = window.tomtomApiKey.substring(0, Math.min(10, window.tomtomApiKey.length)) + '...';
                console.log('TomTom API Key durumu: Mevcut (' + keyPreview + ')');
            } else {
                console.log('TomTom API Key durumu: Bulunamadı veya boş');
            }
            
            // Razor kodunu kontrol etmek için
            var isValidApiKey = window.tomtomApiKey && 
                                window.tomtomApiKey.length > 0 && 
                                window.tomtomApiKey !== 'undefined' &&
                                window.tomtomApiKey.indexOf('Html.Raw') === -1;
            
            // TomTom haritasını başlat (SDK yüklendikten sonra çağrılacak)
            function initTomTomMap() {
                // SDK'nın yüklenmesini bekle
                if (typeof tt === 'undefined' || typeof tt.map === 'undefined') {
                    console.warn('TomTom SDK henüz yüklenmedi, tekrar deneniyor...');
                    setTimeout(initTomTomMap, 100);
                    return;
                }

                if (!document.getElementById('businessMap')) {
                    console.error('Harita elementi bulunamadı: businessMap');
                    return;
                }

                try {
                    // TomTom haritasını oluştur - Dark Mode tema
                    const apiKey = window.tomtomApiKey;
                    
                    if (!apiKey || apiKey.trim() === '' || typeof apiKey !== 'string') {
                        console.error('TomTom API anahtarı geçersiz veya bulunamadı');
                        if (mapStatus) {
                            mapStatus.classList.remove('d-none');
                            mapStatus.querySelector('p').textContent = 'TomTom API anahtarı yapılandırılmamış. OpenStreetMap kullanılıyor.';
                        }
                        // Harita olmadan devam et, sadece marker'ları göster
                        return;
                    }
                    
                    const tomtomMap = tt.map({
                        key: apiKey,
                        container: 'businessMap',
                        center: [31.9995, 36.5437], // [lng, lat] formatında
                        zoom: 12
                        // TomTom SDK varsayılan stil kullanılacak, dark mode CSS ile uygulanacak
                    });

                    window.tomtomMap = tomtomMap;
                    window.infoWindow = null; // TomTom'da popup farklı çalışır
                    
                    tomtomMap.on('load', function() {
                        console.log('TomTom haritası yüklendi');
                        loadBusinessMarkersTomTom();
                    });

                    tomtomMap.on('error', function(error) {
                        console.error('TomTom harita hatası:', error);
                        if (mapStatus) {
                            mapStatus.classList.remove('d-none');
                            mapStatus.querySelector('p').textContent = 'Harita yüklenirken bir hata oluştu.';
                        }
                    });
                } catch (error) {
                    console.error('TomTom haritası oluşturulurken hata:', error);
                    if (mapStatus) {
                        mapStatus.classList.remove('d-none');
                        mapStatus.querySelector('p').textContent = 'Harita oluşturulurken bir hata oluştu: ' + error.message;
                    }
                }
            }

            // DOM yüklendikten sonra da kontrol et
            document.addEventListener('DOMContentLoaded', function() {
                // SDK yüklendikten sonra kontrol et
                if (typeof tt !== 'undefined' && typeof tt.map !== 'undefined') {
                    // SDK zaten yüklenmiş
                    initTomTomMap();
                } else {
                    // SDK henüz yüklenmemiş, script onload bekleniyor
                    console.log('TomTom SDK yüklenmesi bekleniyor...');
                }
            });
        </script>
        <!-- TomTom SDK'yı fonksiyon tanımlandıktan sonra yükle -->
        <script src="https://api.tomtom.com/maps-sdk-for-web/cdn/6.x/6.25.0/maps/maps-web.min.js" 
                onload="if(typeof initTomTomMap === 'function') { initTomTomMap(); } else { console.warn('initTomTomMap fonksiyonu bulunamadı'); }" 
                onerror="console.error('TomTom Maps SDK yüklenemedi')"></script>
        <script>
            // TomTom için marker yükleme fonksiyonu
            function loadBusinessMarkersTomTom() {
                // Harita yoksa bile geocoding yapılabilir (OpenStreetMap ile)
                // Ama marker'lar gösterilemez
                if (!window.tomtomMap) {
                    console.warn('TomTom haritası henüz hazır değil veya API anahtarı yok. Geocoding yapılıyor ama marker\'lar gösterilemeyecek.');
                    // Harita yoksa sadece geocoding yap ama marker ekleme
                    // Kullanıcıya bilgi ver
                    if (mapStatus) {
                        mapStatus.classList.remove('d-none');
                        mapStatus.querySelector('p').textContent = 'Harita yükleniyor veya API anahtarı eksik. Geocoding yapılıyor...';
                    }
                    return;
                }
                
                fetch('@Url.Action("Locations", "Businesses")')
                    .then(response => {
                        if (!response.ok) {
                            throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                        }
                        return response.json();
                    })
                    .then(data => {
                        if (!Array.isArray(data)) {
                            console.error('Beklenmeyen veri formatı:', data);
                            if (mapStatus) {
                                mapStatus.classList.remove('d-none');
                                mapStatus.querySelector('p').textContent = 'Sunucudan beklenmeyen bir yanıt alındı.';
                            }
                            return;
                        }
                        
                        if (data.length === 0) {
                            console.warn('Konum verisi bulunamadı');
                            if (mapStatus) {
                                mapStatus.classList.remove('d-none');
                                mapStatus.querySelector('p').textContent = 'Henüz konumu belirtilmiş bir işletme bulunamadı.';
                            }
                            return;
                        }
                        
                        console.log(`${data.length} işletme konumu yüklendi`);

                        if (mapStatus) {
                            mapStatus.classList.add('d-none');
                        }
                        
                        const bounds = [];
                        const markers = [];
                        let processedCount = 0;
                        const totalItems = data.length;
                        
                        // Rate limiting için delay
                        let geocodeDelay = 0;
                        const geocodeDelayStep = 1200; // Her geocoding için 1.2 saniye bekle (OpenStreetMap rate limit)

                        // Tüm işletmeleri işle
                        data.forEach((item, index) => {
                            let position = null;
                            
                            if (item.hasCoordinates && item.latitude && item.longitude) {
                                // Koordinat varsa direkt marker ekle
                                position = [item.longitude, item.latitude];
                                addTomTomMarker(item, position);
                            } else if (item.address) {
                                // Geocoding için TomTom/OpenStreetMap kullan (rate limiting ile)
                                setTimeout(() => {
                                    geocodeAddressTomTom(item.address, function(coords) {
                                        if (coords) {
                                            addTomTomMarker(item, coords);
                                        } else {
                                            // Geocoding başarısız
                                            processedCount++;
                                            console.warn(`Geocoding başarısız: ${item.name} - ${item.address}`);
                                            checkIfAllProcessed();
                                        }
                                    });
                                }, geocodeDelay);
                                geocodeDelay += geocodeDelayStep; // Her geocoding için delay artır
                            } else {
                                // Ne koordinat ne de adres var
                                processedCount++;
                                console.warn(`Koordinat veya adres yok: ${item.name}`);
                                checkIfAllProcessed();
                            }
                        });
                        
                        function addTomTomMarker(item, position) {
                            if (!position || !Array.isArray(position) || position.length !== 2) {
                                processedCount++;
                                checkIfAllProcessed();
                                return;
                            }
                            
                            // Harita yoksa marker eklenemez
                            if (!window.tomtomMap) {
                                console.warn('Harita hazır değil, marker eklenemedi:', item.name);
                                processedCount++;
                                checkIfAllProcessed();
                                return;
                            }
                            
                            try {
                                // TomTom marker oluştur
                                const marker = new tt.Marker()
                                    .setLngLat(position)
                                    .addTo(window.tomtomMap);
                                
                                bounds.push(position);
                                markers.push(marker);
                                
                                // Popup oluştur
                                const popup = new tt.Popup({ offset: 30 })
                                    .setHTML(`
                                        <div class="map-popup">
                                            <div class="popup-header">
                                                <h4 class="popup-title">${escapeHtml(item.name ?? 'İşletme')}</h4>
                                                ${item.category ? `<span class="popup-category">${escapeHtml(item.category)}</span>` : ''}
                                            </div>
                                            ${item.address ? `
                                                <div class="popup-address">
                                                    <i class="fas fa-map-marker-alt"></i>
                                                    <span>${escapeHtml(item.address)}</span>
                                                </div>
                                            ` : ''}
                                            <div class="popup-stats">
                                                <div class="popup-stat">
                                                    <i class="fas fa-star"></i>
                                                    <span>${(item.averageRating ?? 0).toFixed(1)}</span>
                                                </div>
                                                <div class="popup-stat">
                                                    <i class="fas fa-comment"></i>
                                                    <span>${item.totalReviews ?? 0}</span>
                                                </div>
                                            </div>
                                            <a href="/Businesses/Details/${item.id}" class="popup-button">
                                                <span>Detayları Gör</span>
                                                <i class="fas fa-arrow-right"></i>
                                            </a>
                                        </div>
                                    `);
                                
                                marker.setPopup(popup);
                                
                                processedCount++;
                                checkIfAllProcessed();
                            } catch (error) {
                                console.error('Marker eklenirken hata:', error, item);
                                processedCount++;
                                checkIfAllProcessed();
                            }
                        }
                        
                        // HTML escape fonksiyonu
                        function escapeHtml(text) {
                            if (!text) return '';
                            const div = document.createElement('div');
                            div.textContent = text;
                            return div.innerHTML;
                        }
                        
                        function checkIfAllProcessed() {
                            console.log(`İşlenen: ${processedCount}/${totalItems}, Marker sayısı: ${markers.length}, Bounds: ${bounds.length}`);
                            
                            if (processedCount >= totalItems) {
                                if (bounds.length > 0) {
                                    // Tüm marker'lar eklendi, haritayı ayarla
                                    try {
                                        const boundsObj = bounds.reduce(function(bounds, coord) {
                                            return bounds.extend(coord);
                                        }, new tt.LngLatBounds(bounds[0], bounds[0]));
                                        
                                        window.tomtomMap.fitBounds(boundsObj, {
                                            padding: 50,
                                            maxZoom: 15
                                        });
                                        
                                        console.log(`${markers.length} marker haritaya başarıyla eklendi`);
                                        
                                        if (mapStatus) {
                                            mapStatus.classList.add('d-none');
                                        }
                                    } catch (error) {
                                        console.error('Harita bounds ayarlanırken hata:', error);
                                        if (mapStatus) {
                                            mapStatus.classList.remove('d-none');
                                            mapStatus.querySelector('p').textContent = 'Harita ayarlanırken bir hata oluştu.';
                                        }
                                    }
                                } else {
                                    // Hiç marker eklenemedi
                                    console.warn('Hiç marker eklenemedi. Toplam işletme: ' + totalItems);
                                    if (mapStatus) {
                                        mapStatus.classList.remove('d-none');
                                        mapStatus.querySelector('p').textContent = 'İşletme konumları yüklenemedi. Lütfen işletmelerin konum bilgilerinin (koordinat veya adres) doğru olduğundan emin olun.';
                                    }
                                }
                            }
                        }
                    })
                    .catch(error => {
                        console.error('Harita verileri yüklenirken hata:', error);
                        if (mapStatus) {
                            mapStatus.classList.remove('d-none');
                            mapStatus.querySelector('p').textContent = 'Harita verileri yüklenirken bir hata oluştu: ' + error.message;
                        }
                    });
            }
            
            // TomTom Geocoding - Fallback ile OpenStreetMap
            function geocodeAddressTomTom(address, callback) {
                // TomTom API anahtarı kontrolü
                const apiKey = window.tomtomApiKey;
                
                // TomTom API anahtarı varsa ve geçerliyse kullan
                var isValidKey = apiKey && 
                                 apiKey.trim() !== '' && 
                                 apiKey !== 'undefined' && 
                                 typeof apiKey === 'string' &&
                                 apiKey.indexOf('Html.Raw') === -1;
                
                if (isValidKey) {
                    const query = encodeURIComponent(address + ', Alanya, Antalya');
                    
                    fetch(`https://api.tomtom.com/search/2/geocode/${query}.json?key=${apiKey}&limit=1`)
                        .then(response => {
                            if (!response.ok) {
                                throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                            }
                            return response.json();
                        })
                        .then(data => {
                            if (data.results && data.results.length > 0) {
                                const result = data.results[0];
                                console.log('TomTom geocoding başarılı:', address);
                                callback([result.position.lon, result.position.lat]);
                            } else {
                                // TomTom başarısız, OpenStreetMap'e geç
                                console.warn('TomTom geocoding sonuç bulamadı, OpenStreetMap deneniyor:', address);
                                geocodeWithOpenStreetMap(address, callback);
                            }
                        })
                        .catch(error => {
                            console.warn('TomTom geocoding hatası, OpenStreetMap deneniyor:', error.message);
                            geocodeWithOpenStreetMap(address, callback);
                        });
                } else {
                    // TomTom API anahtarı yok veya geçersiz, direkt OpenStreetMap kullan
                    console.log('TomTom API anahtarı bulunamadı veya geçersiz, OpenStreetMap kullanılıyor');
                    geocodeWithOpenStreetMap(address, callback);
                }
            }
            
            // OpenStreetMap Nominatim Geocoding (Fallback)
            function geocodeWithOpenStreetMap(address, callback) {
                // Adresi temizle ve optimize et
                let cleanAddress = address;
                
                // Türkiye ekle
                if (!cleanAddress.toLowerCase().includes('türkiye') && !cleanAddress.toLowerCase().includes('turkey')) {
                    cleanAddress = cleanAddress + ', Türkiye';
                }
                
                // Alanya ekle
                if (!cleanAddress.toLowerCase().includes('alanya')) {
                    cleanAddress = cleanAddress + ', Alanya';
                }
                
                const query = encodeURIComponent(cleanAddress);
                
                fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${query}&limit=1&addressdetails=1&countrycodes=tr`, {
                    headers: {
                        'User-Agent': 'Plafind/1.0 (Contact: info@plafind.com)'
                    }
                })
                    .then(response => {
                        if (!response.ok) {
                            throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                        }
                        return response.json();
                    })
                    .then(data => {
                        if (data && data.length > 0) {
                            const result = data[0];
                            console.log('OpenStreetMap geocoding başarılı:', address, '->', [parseFloat(result.lon), parseFloat(result.lat)]);
                            callback([parseFloat(result.lon), parseFloat(result.lat)]);
                        } else {
                            console.warn('OpenStreetMap geocoding sonuç bulamadı:', address);
                            callback(null);
                        }
                    })
                    .catch(error => {
                        console.error('OpenStreetMap geocoding hatası:', error, address);
                        callback(null);
                    });
            }
        </script>
    }
    else if (!string.IsNullOrEmpty(googleMapsApiKey))
    {
        <!-- Google Maps API (Fallback) -->
        <script async defer src="https://maps.googleapis.com/maps/api/js?key=@googleMapsApiKey&libraries=places&callback=initBusinessMap"></script>
    }
    else
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var fallbackStatus = document.getElementById('mapStatus');
                if (fallbackStatus) {
                    fallbackStatus.classList.remove('d-none');
                    fallbackStatus.querySelector('p').textContent = 'Harita API anahtarı bulunamadı.';
                }
            });
        </script>
    }
}

