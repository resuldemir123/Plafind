@model Plafind.ViewModels.UserProfileViewModel
@using System.IO;
@using System.Linq;

@{
    ViewData["Title"] = "Profil Ayarları";
    var defaultAvatars = Model.DefaultAvatars ?? Enumerable.Empty<string>();
    var currentAvatar = string.IsNullOrWhiteSpace(Model.CurrentAvatarUrl)
        ? Url.Content("~/images/default-avatar.svg")
        : Url.Content(Model.CurrentAvatarUrl.StartsWith("/") ? "~" + Model.CurrentAvatarUrl : (Model.CurrentAvatarUrl.StartsWith("~/") ? Model.CurrentAvatarUrl : "~/" + Model.CurrentAvatarUrl));
}

<div class="profile-settings-container">
    <!-- Header -->
    <div class="profile-header mb-4">
        <h1 class="profile-title">
            <i class="fas fa-user-cog me-2"></i>Profil Ayarları
        </h1>
        <p class="profile-subtitle">Hesap bilgilerinizi ve tercihlerinizi buradan yönetebilirsiniz</p>
    </div>

    <!-- Alert Messages -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            <strong>Hata!</strong> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            <strong>Başarılı!</strong> @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Sol Menü (Sidebar) -->
        <div class="col-lg-3">
            <div class="profile-sidebar-modern">
                <nav class="profile-nav-modern" id="profileNav">
                    <a href="#section-overview" class="nav-item-modern active">
                        <i class="fas fa-user-circle"></i>
                        <span>Genel Bilgiler</span>
                    </a>
                    <a href="#section-security" class="nav-item-modern">
                        <i class="fas fa-shield-alt"></i>
                        <span>Güvenlik</span>
                    </a>
                    <a href="#section-media" class="nav-item-modern">
                        <i class="fas fa-images"></i>
                        <span>Fotoğraflar</span>
                    </a>
                </nav>
            </div>
        </div>

        <!-- Sağ İçerik -->
        <div class="col-lg-9">
            <!-- Genel Bilgiler Bölümü -->
            <section id="section-overview" class="profile-section-modern" data-profile-section>
                <div class="profile-card-modern">
                    <!-- Profil Fotoğrafı Üst Kısım -->
                    <div class="profile-photo-section">
                        <div class="avatar-container-modern">
                            <img src="@currentAvatar" alt="Profil avatarı" id="avatarPreview" class="avatar-image-modern" />
                            <button type="button" class="avatar-edit-btn" id="changeAvatarBtn" title="Fotoğrafı Değiştir">
                                <i class="fas fa-camera"></i>
                            </button>
                        </div>
                        <div class="profile-info-header">
                            <h3 class="profile-name">@(Model.DisplayName ?? Model.FullName ?? Model.UserName ?? "Kullanıcı")</h3>
                            <p class="profile-role">
                                <i class="fas fa-envelope me-1"></i>@(Model.Email ?? "E-posta belirtilmemiş")
                            </p>
                        </div>
                    </div>

                    <!-- Görüntüleme Modu -->
                    <div id="profileViewMode" class="profile-view-mode-modern">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="info-field-modern">
                                    <label class="info-label-modern">
                                        <i class="fas fa-at me-2"></i>Kullanıcı Adı
                                    </label>
                                    <div class="info-value-modern">@(Model.UserName ?? "Belirtilmemiş")</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-field-modern">
                                    <label class="info-label-modern">
                                        <i class="fas fa-user me-2"></i>Görünen Ad
                                    </label>
                                    <div class="info-value-modern">@(Model.DisplayName ?? "Belirtilmemiş")</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-field-modern">
                                    <label class="info-label-modern">
                                        <i class="fas fa-id-card me-2"></i>Ad Soyad
                                    </label>
                                    <div class="info-value-modern">@(Model.FullName ?? "Belirtilmemiş")</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-field-modern">
                                    <label class="info-label-modern">
                                        <i class="fas fa-phone me-2"></i>Telefon
                                    </label>
                                    <div class="info-value-modern">@(Model.PhoneNumber ?? "Belirtilmemiş")</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-field-modern">
                                    <label class="info-label-modern">
                                        <i class="fas fa-globe me-2"></i>Ülke
                                    </label>
                                    <div class="info-value-modern">@(Model.Country ?? "Belirtilmemiş")</div>
                                </div>
                            </div>
                            <div class="col-md-6" id="cityViewContainer" style="@(Model.Country == "Türkiye" ? "" : "display: none;")">
                                <div class="info-field-modern">
                                    <label class="info-label-modern">
                                        <i class="fas fa-map-marker-alt me-2"></i>Şehir
                                    </label>
                                    <div class="info-value-modern">@(Model.City ?? "Belirtilmemiş")</div>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex justify-content-end mt-4">
                            <button type="button" class="btn btn-primary btn-lg" id="editProfileBtn">
                                <i class="fas fa-edit me-2"></i>Düzenle
                            </button>
                        </div>
                    </div>

                    <!-- Düzenleme Modu -->
                    <form asp-action="UpdateProfile" method="post" enctype="multipart/form-data" id="profileForm" class="profile-form-modern" style="display: none;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="SelectedAvatar" id="selectedAvatarInput" value="@(Model.SelectedAvatar ?? Model.CurrentAvatarUrl)">
                        <input type="file" class="d-none" name="AvatarFile" id="avatarFileInput" accept="image/*">

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="UserName" class="form-label-modern">
                                    <i class="fas fa-at me-2"></i>Kullanıcı Adı
                                </label>
                                <input asp-for="UserName" class="form-control-modern" placeholder="Kullanıcı adınızı girin" />
                                <span asp-validation-for="UserName" class="text-danger small d-block mt-1"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DisplayName" class="form-label-modern">
                                    <i class="fas fa-user me-2"></i>Görünen Ad
                                </label>
                                <input asp-for="DisplayName" class="form-control-modern" placeholder="Profilinizde görünecek ad" />
                                <span asp-validation-for="DisplayName" class="text-danger small d-block mt-1"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Email" class="form-label-modern">
                                    <i class="fas fa-envelope me-2"></i>E-posta Adresi
                                </label>
                                <input asp-for="Email" class="form-control-modern" readonly />
                                <small class="form-text-modern">
                                    <i class="fas fa-info-circle me-1"></i>E-posta adresinizi Güvenlik bölümünden güncelleyebilirsiniz.
                                </small>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label-modern">
                                    <i class="fas fa-id-card me-2"></i>Ad Soyad
                                </label>
                                <input asp-for="FullName" class="form-control-modern" placeholder="Gerçek adınız (isteğe bağlı)" />
                                <span asp-validation-for="FullName" class="text-danger small d-block mt-1"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label-modern">
                                    <i class="fas fa-phone me-2"></i>Telefon
                                </label>
                                <input asp-for="PhoneNumber" class="form-control-modern" placeholder="+90 5XX XXX XX XX" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small d-block mt-1"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Country" class="form-label-modern">
                                    <i class="fas fa-globe me-2"></i>Ülke
                                </label>
                                <select asp-for="Country" class="form-control-modern" id="countrySelect">
                                    <option value="">Ülke Seçiniz</option>
                                    <option value="Türkiye">Türkiye</option>
