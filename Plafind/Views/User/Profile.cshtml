            </section>

            <!-- Güvenlik Bölümü -->
            <section id="section-security" class="profile-section-modern" data-profile-section>
                <div class="profile-card-modern">
                    <h3 class="section-title-modern">
                        <i class="fas fa-shield-alt me-2"></i>Güvenlik ve Hesap Ayarları
                    </h3>
                    <div class="row g-4">
                        <div class="col-lg-6">
                            <div class="security-card-modern">
                                <div class="security-card-header-modern">
                                    <div class="security-icon-modern">
                                        <i class="fas fa-envelope"></i>
                                    </div>
                                    <div>
                                        <h5 class="security-title-modern">E-posta Güncelleme</h5>
                                        <p class="security-subtitle-modern">E-posta adresinizi değiştirin</p>
                                    </div>
                                </div>
                                <div class="security-card-body-modern">
                                    <div class="current-email-modern">
                                        <i class="fas fa-envelope-open me-2"></i>
                                        <span>Mevcut E-posta:</span>
                                        <strong>@(Model.Email ?? "Belirtilmemiş")</strong>
                                    </div>
                                    <form asp-action="ChangeEmail" method="post" class="mt-3">
                                        @Html.AntiForgeryToken()
                                        <div class="mb-3">
                                            <label for="newEmail" class="form-label-modern">
                                                <i class="fas fa-envelope me-2"></i>Yeni E-posta
                                            </label>
                                            <input type="email" class="form-control-modern" id="newEmail" name="NewEmail" placeholder="yeni@email.com" required>
                                        </div>
                                        <div class="mb-3">
                                            <label for="currentPasswordEmail" class="form-label-modern">
                                                <i class="fas fa-lock me-2"></i>Mevcut Şifre
                                            </label>
                                            <input type="password" class="form-control-modern" id="currentPasswordEmail" name="CurrentPassword" placeholder="Şifrenizi girin" required>
                                        </div>
                                        <button type="submit" class="btn btn-primary w-100">
                                            <i class="fas fa-save me-2"></i>E-postayı Güncelle
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="security-card-modern">
                                <div class="security-card-header-modern">
                                    <div class="security-icon-modern password-icon-modern">
                                        <i class="fas fa-key"></i>
                                    </div>
                                    <div>
                                        <h5 class="security-title-modern">Şifre Değiştirme</h5>
                                        <p class="security-subtitle-modern">E-posta ile şifre sıfırlama linki alın</p>
                                    </div>
                                </div>
                                <div class="security-card-body-modern">
                                    <div class="password-info-modern">
                                        <i class="fas fa-info-circle me-2"></i>
                                        <span>Şifrenizi değiştirmek için e-posta adresinize sıfırlama linki gönderebiliriz.</span>
                                    </div>
                                    <form asp-action="RequestPasswordReset" method="post" class="mt-3">
                                        @Html.AntiForgeryToken()
                                        <div class="mb-3">
                                            <label class="form-label-modern">
                                                <i class="fas fa-envelope me-2"></i>E-posta Adresi
                                            </label>
                                            <input type="email" class="form-control-modern" value="@(Model.Email ?? "")" readonly>
                                            <small class="form-text-modern">
                                                Şifre sıfırlama linki bu e-posta adresine gönderilecektir.
                                            </small>
                                        </div>
                                        <button type="submit" class="btn btn-warning w-100">
                                            <i class="fas fa-paper-plane me-2"></i>Şifre Sıfırlama Linki Gönder
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Fotoğraflar Bölümü -->
            <section id="section-media" class="profile-section-modern" data-profile-section>
                <div class="profile-card-modern">
                    <h3 class="section-title-modern">
                        <i class="fas fa-images me-2"></i>Bölgede Çektiğim Fotoğraflar
                    </h3>
                    <form asp-action="UploadPhotos" method="post" enctype="multipart/form-data" id="photoUploadForm" class="mb-4">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label for="photoFiles" class="form-label-modern">
                                <i class="fas fa-upload me-2"></i>Fotoğraf Yükle
                            </label>
                            <input type="file" class="form-control-modern" id="photoFiles" name="photoFiles" accept="image/*" multiple>
                            <small class="form-text-modern">Birden fazla fotoğraf seçebilirsiniz (maks. 5MB her biri)</small>
                        </div>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-upload me-2"></i>Fotoğrafları Yükle
                        </button>
                    </form>

                    <div class="photos-gallery-modern" id="photosGallery">
                        @if (Model.Photos != null && Model.Photos.Any())
                        {
                            <div class="row g-3">
                                @foreach (var photo in Model.Photos.OrderByDescending(p => p.CreatedDate))
                                {
                                    <div class="col-md-4 col-lg-3">
                                        <div class="photo-item-modern">
                                            <img src="@Url.Content(photo.PhotoUrl)" alt="@photo.Description" class="photo-thumbnail-modern">
                                            <div class="photo-overlay-modern">
                                                <button type="button" class="btn btn-sm btn-danger delete-photo-btn" data-photo-id="@photo.Id">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="empty-photos-modern">
                                <i class="fas fa-images fa-3x mb-3"></i>
                                <p>Henüz fotoğraf yüklenmemiş.</p>
                            </div>
                        }
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

<!-- Avatar Seçim Modal -->
<div class="modal fade" id="avatarModal" tabindex="-1" aria-labelledby="avatarModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="avatarModalLabel">
                    <i class="fas fa-user-circle me-2"></i>Avatar Seç
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-4">
                    <label class="form-label-modern mb-3">Varsayılan Avatarlar</label>
                    <div class="avatar-grid-modern">
                        @foreach (var avatar in defaultAvatars)
                        {
                            var isChecked = string.Equals(Model.CurrentAvatarUrl, avatar, StringComparison.OrdinalIgnoreCase);
                            var avatarId = $"avatar_{System.IO.Path.GetFileNameWithoutExtension(avatar)}";
                            <label class="avatar-option-modern @(isChecked ? "active" : "")" for="@avatarId">
                                <input type="radio" id="@avatarId" name="avatarOption" value="@avatar" @(isChecked ? "checked" : "") />
                                <img src="@Url.Content("~" + avatar)" alt="Avatar" />
                            </label>
                        }
                    </div>
                </div>
                <div>
                    <label class="form-label-modern mb-2">Özel Görsel Yükle</label>
                    <input type="file" class="form-control-modern" id="avatarFileInputModal" accept="image/*">
                    <small class="form-text-modern">Desteklenen formatlar: .png, .jpg, .jpeg, .webp, .svg (maks. 2MB)</small>
                </div>
            </div>
            <div class="modal-footer">
                <form asp-action="UpdateProfile" method="post" class="d-none" id="removeAvatarForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="UserName" value="@Model.UserName" />
                    <input type="hidden" name="DisplayName" value="@Model.DisplayName" />
                    <input type="hidden" name="FullName" value="@Model.FullName" />
                    <input type="hidden" name="PhoneNumber" value="@Model.PhoneNumber" />
                    <input type="hidden" name="City" value="@Model.City" />
                    <input type="hidden" name="Country" value="@Model.Country" />
                    <input type="hidden" name="SelectedAvatar" value="remove" />
                </form>
                <button type="button" class="btn btn-outline-danger" onclick="document.getElementById('removeAvatarForm').submit();">
                    <i class="fas fa-times me-2"></i>Avatarı Kaldır
                </button>
                <button type="button" class="btn btn-outline-secondary" id="resetAvatarBtnModal">
                    <i class="fas fa-undo me-2"></i>Varsayılan
                </button>
                <button type="button" class="btn btn-primary" id="saveAvatarBtn">
                    <i class="fas fa-save me-2"></i>Kaydet
                </button>
            </div>
        </div>
    </div>
</div>

<form asp-action="UpdateProfile" method="post" class="d-none" id="removeAvatarForm">
