@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            // Sidebar Navigation
            const navContainer = document.getElementById('profileNav');
            if (navContainer) {
                const navLinks = navContainer.querySelectorAll('.nav-item-modern');
                const sections = document.querySelectorAll('[data-profile-section]');

                navLinks.forEach(link => {
                    link.addEventListener('click', function(e) {
                        e.preventDefault();
                        const targetId = this.getAttribute('href');
                        const targetSection = document.querySelector(targetId);
                        
                        if (targetSection) {
                            navLinks.forEach(l => l.classList.remove('active'));
                            this.classList.add('active');
                            targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        }
                    });
                });

                const observerOptions = {
                    root: null,
                    rootMargin: '-100px 0px -50% 0px',
                    threshold: 0
                };

                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            const id = entry.target.getAttribute('id');
                            navLinks.forEach(link => {
                                link.classList.remove('active');
                                if (link.getAttribute('href') === `#${id}`) {
                                    link.classList.add('active');
                                }
                            });
                        }
                    });
                }, observerOptions);

                sections.forEach(section => observer.observe(section));
            }

            // Avatar Management
            const avatarPreview = document.getElementById('avatarPreview');
            const selectedAvatarInput = document.getElementById('selectedAvatarInput');
            const avatarFileInput = document.getElementById('avatarFileInput');
            const changeAvatarBtn = document.getElementById('changeAvatarBtn');
            const avatarModal = new bootstrap.Modal(document.getElementById('avatarModal'));
            const avatarFileInputModal = document.getElementById('avatarFileInputModal');
            const resetAvatarBtnModal = document.getElementById('resetAvatarBtnModal');
            const saveAvatarBtn = document.getElementById('saveAvatarBtn');
            const defaultAvatar = '@Url.Content("~/images/default-avatar.svg")';

            // Avatar seçim modalını aç
            if (changeAvatarBtn) {
                changeAvatarBtn.addEventListener('click', function() {
                    avatarModal.show();
                });
            }

            // Modal içindeki avatar seçenekleri
            const avatarOptions = document.querySelectorAll('.avatar-option-modern input[type="radio"]');
            avatarOptions.forEach(option => {
                option.addEventListener('change', function () {
                    selectedAvatarInput.value = this.value;
                    avatarPreview.src = this.nextElementSibling.src;
                    document.querySelectorAll('.avatar-option-modern').forEach(opt => opt.classList.remove('active'));
                    this.closest('.avatar-option-modern').classList.add('active');
                    if (avatarFileInputModal) {
                        avatarFileInputModal.value = '';
                    }
                });
            });

            // Modal içindeki dosya seçimi
            if (avatarFileInputModal) {
                avatarFileInputModal.addEventListener('change', function () {
                    if (this.files && this.files[0]) {
                        selectedAvatarInput.value = '';
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            avatarPreview.src = e.target.result;
                        };
                        reader.readAsDataURL(this.files[0]);
                        document.querySelectorAll('.avatar-option-modern').forEach(opt => opt.classList.remove('active'));
                    }
                });
            }

            // Ana formdaki dosya seçimi
            if (avatarFileInput) {
                avatarFileInput.addEventListener('change', function () {
                    if (this.files && this.files[0]) {
                        selectedAvatarInput.value = '';
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            avatarPreview.src = e.target.result;
                        };
                        reader.readAsDataURL(this.files[0]);
                    }
                });
            }

            // Reset avatar
            if (resetAvatarBtnModal) {
                resetAvatarBtnModal.addEventListener('click', function () {
                    selectedAvatarInput.value = '';
                    avatarPreview.src = defaultAvatar;
                    if (avatarFileInputModal) {
                        avatarFileInputModal.value = '';
                    }
                    document.querySelectorAll('.avatar-option-modern').forEach(opt => opt.classList.remove('active'));
                });
            }

            // Save avatar (modal'dan kaydet)
            if (saveAvatarBtn) {
                saveAvatarBtn.addEventListener('click', function() {
                    // Modal'daki dosya seçimini ana forma kopyala
                    if (avatarFileInputModal && avatarFileInputModal.files && avatarFileInputModal.files[0]) {
                        const dataTransfer = new DataTransfer();
                        dataTransfer.items.add(avatarFileInputModal.files[0]);
                        avatarFileInput.files = dataTransfer.files;
                    }
                    avatarModal.hide();
                    // Formu gönder
                    document.getElementById('profileForm').submit();
                });
            }

            // Profil düzenleme modu
            const editProfileBtn = document.getElementById('editProfileBtn');
            const cancelEditBtn = document.getElementById('cancelEditBtn');
            const profileViewMode = document.getElementById('profileViewMode');
            const profileForm = document.getElementById('profileForm');
            const saveButtonsContainer = document.getElementById('saveButtonsContainer');

            if (editProfileBtn) {
                editProfileBtn.addEventListener('click', function() {
                    profileViewMode.style.display = 'none';
                    profileForm.style.display = 'block';
                    saveButtonsContainer.style.display = 'flex';
                    profileForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
                });
            }

            if (cancelEditBtn) {
                cancelEditBtn.addEventListener('click', function() {
                    profileForm.style.display = 'none';
                    saveButtonsContainer.style.display = 'none';
                    profileViewMode.style.display = 'block';
                    profileViewMode.scrollIntoView({ behavior: 'smooth', block: 'start' });
                });
            }

            // Ülke ve Şehir seçimi
            const countrySelect = document.getElementById('countrySelect');
            const citySelectContainer = document.getElementById('citySelectContainer');
            const cityViewContainer = document.getElementById('cityViewContainer');
            const citySelect = document.getElementById('citySelect');
            
            function toggleCitySelect() {
                if (countrySelect && citySelectContainer) {
                    if (countrySelect.value === 'Türkiye') {
                        citySelectContainer.style.display = 'block';
                    } else {
                        citySelectContainer.style.display = 'none';
                        if (citySelect) {
                            citySelect.value = '';
                        }
                    }
                }
            }

            if (countrySelect) {
                countrySelect.value = '@Model.Country';
                countrySelect.addEventListener('change', function() {
                    toggleCitySelect();
                    if (cityViewContainer) {
                        if (this.value === 'Türkiye') {
                            cityViewContainer.style.display = 'block';
                        } else {
                            cityViewContainer.style.display = 'none';
                        }
                    }
                });
                toggleCitySelect();
            }

            if (citySelect) {
                citySelect.value = '@Model.City';
            }

            // Fotoğraf silme
            document.querySelectorAll('.delete-photo-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const photoId = this.getAttribute('data-photo-id');
                    if (confirm('Bu fotoğrafı silmek istediğinize emin misiniz?')) {
                        fetch('@Url.Action("DeletePhoto", "User")', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                            },
                            body: JSON.stringify({ photoId: photoId })
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                location.reload();
                            } else {
                                alert('Fotoğraf silinirken bir hata oluştu.');
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            alert('Fotoğraf silinirken bir hata oluştu.');
                        });
                    }
                });
            });
        })();
    </script>
}
