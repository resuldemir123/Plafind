@model Plafind.Models.ApplicationUser
@using Plafind.Models

@{
    ViewData["Title"] = "Kullanıcı Dashboard";
    var favorites = ViewBag.Favorites as List<UserFavorite> ?? new List<UserFavorite>();
    var reviews = ViewBag.Reviews as List<Review> ?? new List<Review>();
    var reservations = ViewBag.Reservations as List<Reservation> ?? new List<Reservation>();
    var totalFavorites = ViewBag.TotalFavorites as int? ?? 0;
    var totalReviews = ViewBag.TotalReviews as int? ?? 0;
    var totalReservations = ViewBag.TotalReservations as int? ?? 0;
    var pendingReservations = ViewBag.PendingReservations as int? ?? 0;
}

<style>
    .user-dashboard {
        background: var(--bg-body);
        min-height: 100vh;
        padding: 2rem 0;
    }
    .dashboard-header {
        background: var(--bg-surface);
        border: 1px solid var(--border-color);
        border-radius: 15px;
        padding: 2rem;
        margin-bottom: 2rem;
        box-shadow: var(--shadow-lg);
    }
    .dashboard-header h1 {
        color: var(--text-default);
    }
    .dashboard-header p {
        color: var(--text-muted);
    }
    .stat-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-color);
        border-radius: 15px;
        padding: 1.5rem;
        height: 100%;
        box-shadow: var(--shadow-md);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border-left: 4px solid;
    }
    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-xl);
    }
    .stat-card.primary { border-left-color: var(--color-primary); }
    .stat-card.success { border-left-color: var(--color-success); }
    .stat-card.warning { border-left-color: var(--color-warning); }
    .stat-card.info { border-left-color: var(--color-info); }
    .stat-card.danger { border-left-color: var(--color-danger); }
    .stat-card h3 {
        color: var(--text-default);
    }
    .stat-card p {
        color: var(--text-muted);
    }
    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 1rem;
    }
    .stat-icon.primary { background: var(--color-primary-soft); color: var(--color-primary); }
    .stat-icon.success { background: var(--color-success-soft); color: var(--color-success); }
    .stat-icon.warning { background: var(--color-warning-soft); color: var(--color-warning); }
    .stat-icon.info { background: var(--color-info-soft); color: var(--color-info); }
    .stat-icon.danger { background: var(--color-danger-soft); color: var(--color-danger); }
    .content-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-color);
        border-radius: 15px;
        padding: 1.5rem;
        margin-bottom: 2rem;
        box-shadow: var(--shadow-md);
    }
    .content-card-header {
        border-bottom: 2px solid var(--border-color);
        padding-bottom: 1rem;
        margin-bottom: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .content-card-header h5 {
        color: var(--text-default);
    }
    .business-item {
        padding: 1rem;
        border-radius: 10px;
        margin-bottom: 1rem;
        border: 1px solid var(--border-color);
        background: var(--bg-surface);
        transition: all 0.3s ease;
    }
    .business-item:hover {
        background: var(--color-divider-hover-bg);
        border-color: var(--color-primary);
        transform: translateX(5px);
    }
    .business-item h6 a {
        color: var(--text-default);
    }
    .business-item p {
        color: var(--text-muted);
    }
    .review-item {
        padding: 1rem;
        border-radius: 10px;
        margin-bottom: 1rem;
        border-left: 3px solid var(--color-warning);
        background: var(--color-warning-soft);
    }
    .review-item h6 a {
        color: var(--text-default);
    }
    .review-item p {
        color: var(--text-body);
    }
    .reservation-item {
        padding: 1rem;
        border-radius: 10px;
        margin-bottom: 1rem;
        border-left: 3px solid var(--color-info);
        background: var(--color-info-soft);
    }
    .empty-state {
        text-align: center;
        padding: 3rem 1rem;
        color: var(--text-muted);
    }
    .empty-state i {
        font-size: 4rem;
        margin-bottom: 1rem;
        opacity: 0.3;
        color: var(--text-muted);
    }
    .empty-state p {
        color: var(--text-muted);
    }
    .table {
        color: var(--text-default);
    }
    .table thead th {
        color: var(--text-default);
        border-color: var(--border-color);
    }
    .table tbody td {
        color: var(--text-body);
        border-color: var(--border-color);
    }
    .table-hover tbody tr:hover {
        background-color: var(--color-divider-hover-bg);
    }
</style>

<div class="user-dashboard">
    <div class="container-fluid">
        <!-- AI Recommendation Banner -->
        <div class="recommendation-banner card shadow-lg mb-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none;">
            <div class="card-body text-white p-4">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h3 class="mb-2">
                            <i class="fas fa-magic me-2"></i>Bugün Ne Yapsam?
                        </h3>
                        <p class="mb-0">AI destekli kişiselleştirilmiş işletme önerileri ile Alanya'da harika bir gün geçirin</p>
                    </div>
                    <div class="col-md-4 text-end">
                        <a href="@Url.Action("Index", "Recommendation")" class="btn btn-light btn-lg">
                            <i class="fas fa-sparkles me-2"></i>Önerileri Al
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Header -->
        <div class="dashboard-header">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <h1 class="h3 mb-2 fw-bold">
                        <i class="fas fa-tachometer-alt me-2" style="color: var(--color-primary);"></i>Hoş Geldiniz, @(Model.FullName ?? Model.UserName ?? "Kullanıcı")
                    </h1>
                    <p class="mb-0">Dashboard'unuzdan tüm aktivitelerinizi takip edebilirsiniz</p>
                </div>
                <a href="@Url.Action("Profile", "User")" class="btn btn-primary">
                    <i class="fas fa-user-edit me-2"></i>Profili Düzenle
                </a>
            </div>
        </div>

        <!-- İstatistikler -->
        <div class="row mb-4">
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="stat-card primary">
                    <div class="stat-icon primary">
                        <i class="fas fa-heart"></i>
                    </div>
                    <h3 class="fw-bold mb-1">@totalFavorites</h3>
                    <p class="text-muted mb-0">Favori İşletme</p>
                    <a href="@Url.Action("Favorites", "User")" class="btn btn-sm btn-outline-primary mt-2 w-100">
                        <i class="fas fa-eye me-1"></i>Görüntüle
                    </a>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="stat-card success">
                    <div class="stat-icon success">
                        <i class="fas fa-comments"></i>
                    </div>
                    <h3 class="fw-bold mb-1">@totalReviews</h3>
                    <p class="text-muted mb-0">Yorumlarım</p>
                    <a href="@Url.Action("MyReviews", "User")" class="btn btn-sm btn-outline-success mt-2 w-100">
                        <i class="fas fa-eye me-1"></i>Görüntüle
                    </a>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="stat-card info">
                    <div class="stat-icon info">
                        <i class="fas fa-calendar-check"></i>
                    </div>
                    <h3 class="fw-bold mb-1">@totalReservations</h3>
                    <p class="text-muted mb-0">Rezervasyonlarım</p>
                    <a href="@Url.Action("Index", "Reservations")" class="btn btn-sm btn-outline-info mt-2 w-100">
                        <i class="fas fa-eye me-1"></i>Görüntüle
                    </a>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="stat-card warning">
                    <div class="stat-icon warning">
                        <i class="fas fa-clock"></i>
                    </div>
                    <h3 class="fw-bold mb-1">@pendingReservations</h3>
                    <p class="text-muted mb-0">Bekleyen Rezervasyon</p>
                    <a href="@Url.Action("Index", "Reservations")" class="btn btn-sm btn-outline-warning mt-2 w-100">
                        <i class="fas fa-eye me-1"></i>Görüntüle
                    </a>
                </div>
            </div>
        </div>

        <!-- İçerik Bölümleri -->
        <div class="row">
            <!-- Favoriler -->
            <div class="col-lg-6 mb-4">
                <div class="content-card">
                    <div class="content-card-header">
                        <h5 class="mb-0 fw-bold">
                            <i class="fas fa-heart text-danger me-2"></i>Son Favorilerim
                        </h5>
                        <a href="@Url.Action("Favorites", "User")" class="btn btn-sm btn-outline-primary">
                            Tümünü Gör <i class="fas fa-arrow-right ms-1"></i>
                        </a>
                    </div>
                    @if (favorites.Any())
                    {
                        @foreach (var favorite in favorites)
                        {
                            <div class="business-item">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        <h6 class="fw-bold mb-1">
                                            <a href="@Url.Action("Details", "Businesses", new { id = favorite.BusinessId })" class="text-decoration-none">
                                                @favorite.Business?.Name
                                            </a>
                                        </h6>
                                        <p class="text-muted small mb-2">
                                            <i class="fas fa-tag me-1"></i>@(favorite.Business?.Category?.Name ?? "Kategori yok")
                                        </p>
                                        @if (favorite.Business?.AverageRating > 0)
                                        {
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="fw-bold">@favorite.Business.AverageRating.ToString("F1")</span>
                                                <div class="text-warning">
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        if (i <= Math.Floor(favorite.Business.AverageRating))
                                                        {
                                                            <i class="fas fa-star"></i>
                                                        }
                                                        else if (i - 0.5 <= favorite.Business.AverageRating)
                                                        {
                                                            <i class="fas fa-star-half-alt"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="far fa-star"></i>
                                                        }
                                                    }
                                                </div>
                                                <span class="text-muted small">(@favorite.Business.TotalReviews yorum)</span>
                                            </div>
                                        }
                                        <small class="text-muted">
                                            <i class="fas fa-calendar me-1"></i>@favorite.AddedDate.ToString("dd MMMM yyyy")
                                        </small>
                                    </div>
                                    <div class="ms-3">
                                        <a href="@Url.Action("Details", "Businesses", new { id = favorite.BusinessId })" class="btn btn-sm btn-primary">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fas fa-heart"></i>
                            <p class="mb-0">Henüz favori işletmeniz yok</p>
                            <a href="@Url.Action("Search", "Home")" class="btn btn-primary mt-3">
                                <i class="fas fa-search me-2"></i>İşletme Ara
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- Yorumlar -->
            <div class="col-lg-6 mb-4">
                <div class="content-card">
                    <div class="content-card-header">
                        <h5 class="mb-0 fw-bold">
                            <i class="fas fa-comments text-warning me-2"></i>Son Yorumlarım
                        </h5>
                        <a href="@Url.Action("MyReviews", "User")" class="btn btn-sm btn-outline-warning">
                            Tümünü Gör <i class="fas fa-arrow-right ms-1"></i>
                        </a>
                    </div>
                    @if (reviews.Any())
                    {
                        @foreach (var review in reviews)
                        {
                            <div class="review-item">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <h6 class="fw-bold mb-1">
                                            <a href="@Url.Action("Details", "Businesses", new { id = review.BusinessId })" class="text-decoration-none">
                                                @review.Business?.Name
                                            </a>
                                        </h6>
                                        <div class="text-warning mb-2">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= review.Rating)
                                                {
                                                    <i class="fas fa-star"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-star"></i>
                                                }
                                            }
                                        </div>
                                    </div>
                                    <span class="badge bg-@(review.IsApproved ? "success" : "warning")">
                                        @(review.IsApproved ? "Onaylandı" : "Beklemede")
                                    </span>
                                </div>
                                <p class="mb-2">@(review.Comment?.Length > 100 ? review.Comment.Substring(0, 100) + "..." : review.Comment)</p>
                                <small class="text-muted">
                                    <i class="fas fa-calendar me-1"></i>@review.CreatedDate.ToString("dd MMMM yyyy")
                                </small>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fas fa-comments"></i>
                            <p class="mb-0">Henüz yorum yapmadınız</p>
                            <a href="@Url.Action("Search", "Home")" class="btn btn-warning mt-3">
                                <i class="fas fa-comment me-2"></i>Yorum Yap
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Rezervasyonlar -->
        <div class="row">
            <div class="col-12">
                <div class="content-card">
                    <div class="content-card-header">
                        <h5 class="mb-0 fw-bold">
                            <i class="fas fa-calendar-check text-info me-2"></i>Son Rezervasyonlarım
                        </h5>
                        <a href="@Url.Action("Index", "Reservations")" class="btn btn-sm btn-outline-info">
                            Tümünü Gör <i class="fas fa-arrow-right ms-1"></i>
                        </a>
                    </div>
                    @if (reservations.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>İşletme</th>
                                        <th>Tarih</th>
                                        <th>Saat</th>
                                        <th>Kişi Sayısı</th>
                                        <th>Durum</th>
                                        <th>İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var reservation in reservations)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@(reservation.Branch?.Business?.Name ?? reservation.Business?.Name ?? "Bilinmiyor")</strong>
                                                @if (reservation.Branch != null)
                                                {
                                                    <br><small class="text-muted">@reservation.Branch.Name</small>
                                                }
                                            </td>
                                            <td>@reservation.RequestedDate.ToString("dd MMMM yyyy")</td>
                                            <td>@reservation.RequestedTime.ToString(@"hh\:mm")</td>
                                            <td>@reservation.NumberOfPeople kişi</td>
                                            <td>
                                                @{
                                                    var statusClass = (reservation.Status?.ToLower()) switch
                                                    {
                                                        "onaylandı" or "approved" => "success",
                                                        "reddedildi" or "rejected" => "danger",
                                                        "iptal edildi" or "cancelled" => "secondary",
                                                        "beklemede" or "pending" => "warning",
                                                        _ => "warning"
                                                    };
                                                }
                                                <span class="badge bg-@statusClass">@(reservation.Status ?? "Beklemede")</span>
                                            </td>
                                            <td>
                                                <a href="@Url.Action("Details", "Reservations", new { id = reservation.Id })" class="btn btn-sm btn-primary">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fas fa-calendar-check"></i>
                            <p class="mb-0">Henüz rezervasyonunuz yok</p>
                            <a href="@Url.Action("Search", "Home")" class="btn btn-info mt-3">
                                <i class="fas fa-calendar-plus me-2"></i>Rezervasyon Yap
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Hızlı Erişim -->
        <div class="row">
            <div class="col-12">
                <div class="content-card">
                    <h5 class="fw-bold mb-3">
                        <i class="fas fa-bolt text-warning me-2"></i>Hızlı Erişim
                    </h5>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <a href="@Url.Action("Search", "Home")" class="btn btn-outline-primary w-100 py-3">
                                <i class="fas fa-building fa-2x mb-2 d-block"></i>
                                İşletme Ara
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a href="@Url.Action("Favorites", "User")" class="btn btn-outline-danger w-100 py-3">
                                <i class="fas fa-heart fa-2x mb-2 d-block"></i>
                                Favorilerim
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a href="@Url.Action("MyReviews", "User")" class="btn btn-outline-warning w-100 py-3">
                                <i class="fas fa-comments fa-2x mb-2 d-block"></i>
                                Yorumlarım
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a href="@Url.Action("Profile", "User")" class="btn btn-outline-info w-100 py-3">
                                <i class="fas fa-user-edit fa-2x mb-2 d-block"></i>
                                Profilim
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
