@model List<Plafind.Models.Employee>
@{
    ViewData["Title"] = "Çalışan Yönetimi";
    var business = ViewBag.Business as Plafind.Models.Business;
    var businessId = ViewBag.BusinessId as int?;
    var branches = ViewBag.Branches as List<Plafind.Models.Branch> ?? new List<Plafind.Models.Branch>();
    var selectedBranchId = ViewBag.SelectedBranchId as int?;
    var userBusinesses = ViewBag.UserBusinesses as List<Plafind.Models.Business> ?? new List<Plafind.Models.Business>();
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="mb-0">
                    <i class="fas fa-users me-2"></i>Çalışan Yönetimi
                </h2>
                <div>
                    @if (userBusinesses.Count > 1)
                    {
                        <div class="dropdown d-inline-block me-2">
                            <button class="btn btn-outline-primary dropdown-toggle" type="button" id="businessDropdown" data-bs-toggle="dropdown">
                                <i class="fas fa-building me-2"></i>
                                @(business?.Name ?? "İşletme Seçin")
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="businessDropdown">
                                @foreach (var b in userBusinesses)
                                {
                                    <li>
                                        <a class="dropdown-item @(b.Id == businessId ? "active" : "")" 
                                           href="@Url.Action("Employees", new { businessId = b.Id })">
                                            @b.Name
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#employeeModal" onclick="openEmployeeModal(null)">
                        <i class="fas fa-plus me-2"></i>Yeni Çalışan Ekle
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (business != null)
    {
        @if (branches.Any())
        {
            <div class="row mb-3">
                <div class="col-12">
                    <div class="btn-group" role="group">
                        <a href="@Url.Action("Employees", new { businessId = businessId })" 
                           class="btn btn-@(selectedBranchId == null ? "primary" : "outline-primary")">
                            Tümü
                        </a>
                        @foreach (var branch in branches)
                        {
                            <a href="@Url.Action("Employees", new { businessId = businessId, branchId = branch.Id })" 
                               class="btn btn-@(selectedBranchId == branch.Id ? "primary" : "outline-primary")">
                                @branch.Name
                            </a>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Ad Soyad</th>
                                        <th>Pozisyon</th>
                                        <th>Departman</th>
                                        <th>Şube</th>
                                        <th>Telefon</th>
                                        <th>E-posta</th>
                                        <th>Durum</th>
                                        <th>İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var employee in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@employee.FirstName @employee.LastName</strong>
                                                @if (employee.IsManager)
                                                {
                                                    <span class="badge bg-warning ms-2">Müdür</span>
                                                }
                                            </td>
                                            <td>@employee.Position</td>
                                            <td>@employee.Department</td>
                                            <td>@(employee.Branch?.Name ?? "-")</td>
                                            <td>@employee.Phone</td>
                                            <td>@employee.Email</td>
                                            <td>
                                                <span class="badge bg-@(employee.Status == "Active" ? "success" : employee.Status == "OnLeave" ? "warning" : "secondary")">
                                                    @(employee.Status == "Active" ? "Aktif" : employee.Status == "OnLeave" ? "İzinli" : "Pasif")
                                                </span>
                                            </td>
                                            <td>
                                                <button type="button" class="btn btn-sm btn-outline-primary" 
                                                        onclick="openEmployeeModal(@employee.Id)" data-bs-toggle="modal" data-bs-target="#employeeModal">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <form asp-action="DeleteEmployee" method="post" class="d-inline" 
                                                      onsubmit="return confirm('Bu çalışanı silmek istediğinize emin misiniz?');">
                                                    <input type="hidden" name="id" value="@employee.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-info text-center">
                <i class="fas fa-info-circle me-2"></i>Henüz çalışan eklenmemiş.
            </div>
        }
    }
</div>

<!-- Çalışan Ekleme/Düzenleme Modal -->
<div class="modal fade" id="employeeModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="employeeModalTitle">Yeni Çalışan Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="employeeForm" method="post">
                <div class="modal-body">
                    <input type="hidden" name="BusinessId" value="@businessId" />
                    <input type="hidden" name="Id" id="employeeId" />
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Ad *</label>
                            <input type="text" class="form-control" name="FirstName" id="employeeFirstName" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Soyad *</label>
                            <input type="text" class="form-control" name="LastName" id="employeeLastName" required />
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Telefon</label>
                            <input type="text" class="form-control" name="Phone" id="employeePhone" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">E-posta</label>
                            <input type="email" class="form-control" name="Email" id="employeeEmail" />
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Pozisyon</label>
                            <input type="text" class="form-control" name="Position" id="employeePosition" 
                                   placeholder="Örn: Garson, Şef, Müdür" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Departman</label>
                            <input type="text" class="form-control" name="Department" id="employeeDepartment" 
                                   placeholder="Örn: Mutfak, Servis, Yönetim" />
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Şube</label>
                            <select class="form-select" name="BranchId" id="employeeBranchId">
                                <option value="">Şube Seçin</option>
                                @foreach (var branch in branches)
                                {
                                    <option value="@branch.Id">@branch.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">İşe Başlama Tarihi</label>
                            <input type="date" class="form-control" name="HireDate" id="employeeHireDate" />
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Maaş</label>
                            <input type="number" step="0.01" class="form-control" name="Salary" id="employeeSalary" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Durum</label>
                            <select class="form-select" name="Status" id="employeeStatus">
                                <option value="Active">Aktif</option>
                                <option value="OnLeave">İzinli</option>
                                <option value="Terminated">Pasif</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Notlar</label>
                        <textarea class="form-control" name="Notes" id="employeeNotes" rows="3"></textarea>
                    </div>
                    
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="IsManager" id="employeeIsManager" />
                        <label class="form-check-label" for="employeeIsManager">Müdür</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openEmployeeModal(employeeId) {
        const modal = document.getElementById('employeeModal');
        const form = document.getElementById('employeeForm');
        const title = document.getElementById('employeeModalTitle');
        
        if (employeeId) {
            title.textContent = 'Çalışan Düzenle';
            form.action = '@Url.Action("EditEmployee")';
            
            const employee = @Html.Raw(Json.Serialize(Model));
            const selectedEmployee = employee.find(e => e.id === employeeId);
            
            if (selectedEmployee) {
                document.getElementById('employeeId').value = selectedEmployee.id;
                document.getElementById('employeeFirstName').value = selectedEmployee.firstName || '';
                document.getElementById('employeeLastName').value = selectedEmployee.lastName || '';
                document.getElementById('employeePhone').value = selectedEmployee.phone || '';
                document.getElementById('employeeEmail').value = selectedEmployee.email || '';
                document.getElementById('employeePosition').value = selectedEmployee.position || '';
                document.getElementById('employeeDepartment').value = selectedEmployee.department || '';
                document.getElementById('employeeBranchId').value = selectedEmployee.branchId || '';
                document.getElementById('employeeHireDate').value = selectedEmployee.hireDate ? new Date(selectedEmployee.hireDate).toISOString().split('T')[0] : '';
                document.getElementById('employeeSalary').value = selectedEmployee.salary || '';
                document.getElementById('employeeStatus').value = selectedEmployee.status || 'Active';
                document.getElementById('employeeNotes').value = selectedEmployee.notes || '';
                document.getElementById('employeeIsManager').checked = selectedEmployee.isManager || false;
            }
        } else {
            title.textContent = 'Yeni Çalışan Ekle';
            form.action = '@Url.Action("CreateEmployee")';
            form.reset();
            document.getElementById('employeeId').value = '';
            document.getElementById('employeeStatus').value = 'Active';
            document.getElementById('employeeIsManager').checked = false;
        }
    }
</script>
