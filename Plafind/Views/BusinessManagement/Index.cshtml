@model List<Plafind.Models.Business>
@{
    ViewData["Title"] = "İşletme Yönetimi";
    var userBusinesses = ViewBag.UserBusinesses as List<Plafind.Models.Business> ?? new List<Plafind.Models.Business>();
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="mb-0">
                    <i class="fas fa-building me-2"></i>İşletme Yönetimi
                </h2>
                <div>
                    <a href="@Url.Action("Branches")" class="btn btn-outline-primary me-2">
                        <i class="fas fa-code-branch me-2"></i>Şubeler
                    </a>
                    <a href="@Url.Action("Employees")" class="btn btn-outline-primary">
                        <i class="fas fa-users me-2"></i>Çalışanlar
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        @foreach (var business in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card border-0 shadow-sm h-100">
                    @if (!string.IsNullOrEmpty(business.ImageUrl))
                    {
                        <img src="@business.ImageUrl" class="card-img-top" alt="@business.Name" style="height: 200px; object-fit: cover;">
                    }
                    <div class="card-body">
                        <h5 class="card-title">@business.Name</h5>
                        <p class="card-text text-muted small">
                            <i class="fas fa-map-marker-alt me-1"></i>@business.Address
                        </p>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="fas fa-star @(i <= (int)business.AverageRating ? "text-warning" : "text-muted")"></i>
                                }
                                <small class="text-muted ms-2">@business.AverageRating.ToString("F1") (@business.TotalReviews)</small>
                            </div>
                        </div>
                        <div class="row text-center mb-3">
                            <div class="col-4">
                                <div class="border-end">
                                    <div class="fw-bold">@business.TotalReviews</div>
                                    <small class="text-muted">Yorum</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="border-end">
                                    <div class="fw-bold">@(business.Reservations?.Count ?? 0)</div>
                                    <small class="text-muted">Rezervasyon</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="fw-bold @(business.IsActive ? "text-success" : "text-danger")">
                                    @(business.IsActive ? "Aktif" : "Pasif")
                                </div>
                                <small class="text-muted">Durum</small>
                            </div>
                        </div>
                        <div class="d-grid gap-2">
                            <a href="@Url.Action("Index", "BusinessDashboard", new { businessId = business.Id })" 
                               class="btn btn-primary btn-sm">
                                <i class="fas fa-chart-line me-2"></i>Dashboard
                            </a>
                            <div class="btn-group btn-group-sm" role="group">
                                <a href="@Url.Action("Branches", new { businessId = business.Id })" 
                                   class="btn btn-outline-secondary">
                                    <i class="fas fa-code-branch me-1"></i>Şubeler
                                </a>
                                <a href="@Url.Action("Employees", new { businessId = business.Id })" 
                                   class="btn btn-outline-secondary">
                                    <i class="fas fa-users me-1"></i>Çalışanlar
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            <i class="fas fa-info-circle me-2"></i>Henüz işletme bulunmamaktadır.
        </div>
    }
</div>
